# os / editor
.DS_Store
.claude/
*.log

# deps & build (cobertos também pelo crivo-platform/.gitignore)
node_modules/
dist/
.next/
out/
.turbo/
.vite/

# memoria viva do projeto (contém credenciais — NUNCA versionar)
PROJETO.md
ACESSOS*.md

# env & secrets
# Cobre TODA variacao de .env (inclusive .env.production, que a regra antiga
# deixava passar) e os nomes que a producao usa de fato (api.env / lp.env em
# /opt/crivo). O movimento natural de quem esta aprendendo o deploy e copiar o
# env do servidor para debugar local — sem isto, um `git add -A` versionaria os
# segredos de producao inteiros.
.env
.env.*
!.env.example
*.env
!*.env.example
api.env
lp.env

# chaves, certificados e dumps de banco
*.pem
*.key
*.p12
*.jks
*.p8
*.keystore
service-account*.json
google-services.json
*.sql.gz
*.dump
*.local
.vercel

# dev-only (atalho de login com token — não versionar)
crivo-platform/apps/web/public/dev-login.html

# Capacitor / Android — segredos e artefatos de build (NUNCA versionar)
**/android/key.properties
**/android/local.properties
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/app/release/
**/android/capacitor-cordova-android-plugins/
**/android/app/google-services.json

# Firebase/APNs iOS — segredos (NUNCA versionar)
**/ios/App/App/GoogleService-Info.plist
**/*.p8
*.jks
*.keystore
*.aab
*.apk
