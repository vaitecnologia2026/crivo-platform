// =====================================================================
// CRIVO™ Platform — Prisma schema
// Fase F0: Tenancy + IAM (fundação). Modelos de F1 (ICD/Assessments)
// entram na próxima fase — ver docs/ARCHITECTURE.md §5.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Papéis (RBAC) ──
enum Role {
  COLABORADOR
  LIDER
  GESTOR
  RH
  JURIDICO
  CEO
  ADMIN
  CONSULTOR
  MENTOR
  ACADEMIA
  FINANCEIRO
  VISUALIZADOR
}

enum Plan {
  BASE
  EVOLUCAO
  ENTERPRISE
  ADVISORY
}

enum AssessmentType {
  ICD
  NR1
}

enum CycleStatus {
  OPEN
  CLOSED
}

// Tensão decisória dominante revelada pelo ICD (modelo dos 4 Rs). Substitui o
// antigo "padrão dominante". O nome do enum é mantido por compatibilidade.
enum DominantPattern {
  REATIVIDADE
  RIGIDEZ
  REPERCUSSAO
  RISCO
  EQUILIBRADO // nenhum R se destaca (alta coerência)
}

// Estágio do lead no pipeline comercial.
enum LeadStage {
  NOVO
  CONTATO
  QUALIFICADO
  PROPOSTA
  GANHO
  PERDIDO
}

// Estado de uma empresa-cliente no control plane.
enum TenantStatus {
  ACTIVE
  SUSPENDED // bloqueada: usuários não conseguem logar
  DELETED // exclusão lógica (reversível); purge físico é operação separada
}

// Estado de um Produto no catálogo comercial (control plane).
enum ProductStatus {
  DRAFT // em construção, não vendável
  ACTIVE // publicado, pode ser contratado
  INACTIVE // arquivado
}

// Estágio do lead no funil comercial da CRIVO (CRM do Super Admin). Espelha o
// Kanban do Portal PDF (Print 2): NOVO → PRÉ-DIAGNÓSTICO → REUNIÃO → PROPOSTA →
// FECHADO (+ PERDIDO). Distinto de LeadStage (pipeline interno do tenant).
// Ciclo comercial completo (PDF §4.2 CRM Interno): da captação ao pós-venda.
// Valores antigos (PRE_DIAGNOSTICO/REUNIAO) mantidos p/ compatibilidade de dados.
enum PlatformLeadStage {
  NOVO
  PRE_DIAGNOSTICO
  REUNIAO
  OPORTUNIDADE
  PROPOSTA
  NEGOCIACAO
  FECHADO
  CONTRATO
  ONBOARDING
  IMPLANTACAO
  ENTREGA
  SUSTENTACAO
  RENOVACAO
  UPSELL
  PERDIDO
}

// MÉTODO CRIVO — como a avaliação é conduzida (Briefing §4). Porte/complexidade
// definem o método.
enum DiagnosticMethod {
  INICIAL
  ESSENCIAL
  ORGANIZACIONAL
}

// SAÍDA TÉCNICA — quais documentos são gerados (Briefing §4). Obrigação
// documental define a saída — independente do método. PGR não obriga Organizacional.
enum TechnicalOutput {
  SEM_INTEGRACAO // leitura preliminar, sem caráter AEP/PGR
  AEP // apoio à AEP
  AEP_PGR // apoio à AEP + PGR
}

// Modelo de contratação (Matriz §Contrato): define prazo e recorrência.
enum ContractModel {
  PONTUAL
  SEIS_MESES
  DOZE_MESES
  VINTE_QUATRO_MESES
  CUSTOM
}

// Estado do contrato de um cliente.
enum ContractStatus {
  RASCUNHO
  ATIVO
  SUSPENSO
  ENCERRADO
}

// Status de uma ação do plano (Matriz §Plano de Ação).
enum ActionStatus {
  SUGERIDA
  EM_REVISAO
  APROVADA
  EM_ANDAMENTO
  CONCLUIDA
  REAVALIADA
  /// Sugestao avaliada e recusada pela organizacao. Guarda o rastro da
  /// recomendacao: antes, "nao adotar" so existia apagando a acao, e a
  /// recomendacao sumia como se nunca tivesse sido feita.
  NAO_ADOTADA
}

// Tipo de registro do Diagnóstico Essencial (Briefing §5): escuta com empregados
// ou observação/análise da atividade.
enum EssentialRecordKind {
  ESCUTA
  OBSERVACAO
}

// =====================================================================
// REGISTRO DE DECISÃO (Anexo Técnico ICD do Líder v1, §5–§9).
// Base operacional do ICD: o líder registra decisões reais; o ICD avalia
// a coerência da decisão em 4 eixos (Clareza/Critério/Alinhamento/Sustentação).
// Os enums abaixo cobrem os campos visíveis ao líder (§5.1) e a regra
// de impacto/peso (§9.3). Os modelos de scoring e ciclo vêm nas próximas
// migrations (tasks #46 e #47).
// =====================================================================

// Anexo ICD §5.1 e §9.3 — define peso na média ponderada trimestral.
// BAIXO=0 (fica só no histórico, não entra no ICD oficial); MEDIO=1; ALTO=2.
enum DecisionImpact {
  BAIXO
  MEDIO
  ALTO
}

// Anexo ICD §5.1 — natureza da decisão.
enum DecisionType {
  INDIVIDUAL
  COLETIVA
  RECOMENDACAO_APROVACAO
  COMPARTILHADA
}

// Anexo ICD §5.1 — correlação com uso do Pocket antes/durante a decisão.
enum DecisionPocketUse {
  NAO_UTILIZADO
  ANTES
  DURANTE
}

// Anexo ICD §5.1 — principal fator de pressão sobre a decisão.
enum DecisionPressureFactor {
  URGENCIA
  CONFLITO
  FALTA_INFORMACAO
  PRESSAO_RESULTADO
  RISCO_FINANCEIRO
  RISCO_PESSOAS
  RISCO_JURIDICO
  EXPOSICAO_REPUTACIONAL
  OUTRO
}

// Anexo ICD §5.1 — janela para revisão futura da decisão.
enum DecisionRevisionPeriod {
  D30
  D60
  D90
  SEM_REVISAO
}

// Anexo ICD §5.3 — ciclo de vida da decisão. EM_REGISTRO = rascunho;
// REGISTRADA = no histórico, sem ICD; AVALIADA_PELO_ICD = ICD completo
// respondido. A elegibilidade para o oficial é derivada (impact ≠ BAIXO).
enum DecisionStatus {
  EM_REGISTRO
  REGISTRADA
  AVALIADA_PELO_ICD
}

// Anexo ICD §6 — quatro EIXOS oficiais (substituem os 4 Rs do modelo legado).
// Cada eixo é medido por 2 afirmações (P1-P8, §7) em escala 1–5; o score do
// eixo é a média dos dois scores convertidos (§9.1). O ICD da decisão é a
// média dos 4 eixos (§9.2).
enum IcdAxis {
  CLAREZA // P1/P2 — fatos, dados e lacunas reconhecidas antes da conclusão.
  CRITERIO // P3/P4 — discernimento, prioridade e consistência sob pressão.
  ALINHAMENTO // P5/P6 — pessoas, áreas, processos, comunicação considerados.
  SUSTENTACAO // P7/P8 — coerência com estratégia/cultura/valores; horizonte longo.
}

// Anexo ICD §9.6 — ciclo trimestral do ICD. OPEN = parcial (atualiza ao vivo
// conforme decisões são avaliadas); CLOSED = oficial, congelado para histórico.
enum IcdCycleStatus {
  OPEN
  CLOSED
}

// =====================================================================
// POCKET CRIVO / INTERNAL ENGINE (Anexo Técnico Pocket v1).
// Módulo de Liderança/App: prepara o líder ANTES ou DURANTE decisões
// relevantes via 10 perguntas reflexivas (C1-O2) nas 5 dimensões CRIVO.
// NÃO gera score (§6) e NÃO é avaliação — é apoio metacognitivo (§3).
// =====================================================================

// Anexo Pocket §8 — quando o líder usa o Pocket em relação à decisão.
enum PocketMomentOfUse {
  AVULSO // reflexão sem decisão específica
  ANTES_DECISAO
  DURANTE_DECISAO
}

// Estado da sessão Pocket. EM_ANDAMENTO = pelo menos uma pergunta respondida;
// CONCLUIDA = líder marcou fim. Histórico individual (§13).
enum PocketSessionStatus {
  EM_ANDAMENTO
  CONCLUIDA
}

// Estado de um Relatório Preliminar CRIVO (Diagnóstico Inicial, §7).
// GERANDO → IA está produzindo o conteúdo;
// PRONTO  → conteúdo gerado, ainda não enviado;
// ENVIADO → e-mail entregue ao provider (não significa entregue ao usuário);
// ERRO    → falhou em gerar OU enviar (errorReason preenchido).
enum PreliminaryReportStatus {
  GERANDO
  PRONTO
  ENVIADO
  ERRO
}

// =====================================================================
// RBAC DINÂMICO POR TENANT (#68) — papéis customizados por empresa.
// User.role (enum) continua existindo como FALLBACK; um usuário também
// pode receber 1..N TenantRole (multi-papel). PermissionService combina
// ambos para resolver as permissões efetivas.
// Vive no DATA PLANE (tem tenantId, sob RLS).
// =====================================================================

model TenantRole {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  org         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Slug curto e estável (ex: "lider_comercial"). Único por tenant.
  code        String
  name        String
  description String?
  // Lista de Permission.code (ex: "leads:view", "icd:submit"). Validada no service.
  permissions String[]     @default([])
  // Marca papéis criados via UI vs seed (não é o enum global Role, que é "system").
  isCustom    Boolean      @default(true)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userRoles UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tenant_roles")
}

model UserRole {
  userId       String     @db.Uuid
  tenantRoleId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantRole   TenantRole @relation(fields: [tenantRoleId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())
  assignedBy   String? // e-mail/nome do operador que atribuiu

  @@id([userId, tenantRoleId])
  @@index([tenantRoleId])
  @@map("user_roles")
}

// Mentoria (Matriz §Mentorias / Briefing §10). Formato e status controlados.
enum MentoriaFormat {
  ONLINE
  PRESENCIAL
  HIBRIDA
}

enum MentoriaStatus {
  AGENDADA
  REALIZADA
  CANCELADA
  REAGENDADA
}

// =====================================================================
// CONTROL PLANE (F1) — registro GLOBAL de empresas-cliente e super admins.
// NÃO é escopado por tenant: estas tabelas ficam FORA da RLS por tenant.
// Acesso EXCLUSIVO via conexão owner (prisma.admin) pelo módulo Admin —
// o papel crivo_app tem o acesso REVOGADO (ver prisma/sql/rls.sql).
// Ver docs/SAAS-TRANSFORMATION.md §3 (Control Plane × Data Plane).
// =====================================================================

// Nível 1 — Super Administrador global. Principal SEPARADO do RBAC de tenant
// (não é um User com papel; vive no control plane, sem tenantId).
model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  // Função organizacional do usuário CRIVO (Comercial/Financeiro/Operações…).
  // HOJE é rótulo: todos têm acesso de administrador do painel; permissões
  // diferenciadas por função entram em fase posterior.
  role         String?
  active       Boolean  @default(true)
  tokenVersion Int      @default(0) // revogação de sessão: incrementar invalida os JWTs do admin
  totpSecret   String? // segredo TOTP (definido no setup; pode existir "pendente")
  totpEnabled  Boolean  @default(false) // MFA ativo? exige código no login
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

// Registro mestre de cada empresa-cliente (espelha Organization no data plane).
// Liga ao Organization por organizationId SEM relation Prisma, para manter o
// control plane desacoplado do modelo RLS — relação 1:1 lógica.
model Tenant {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @unique @db.Uuid // → organizations.id (data plane)
  slug                String       @unique // subdomínio: <slug>.crivolegacy.com.br
  name                String
  plan                Plan         @default(BASE)
  status              TenantStatus @default(ACTIVE)
  productId           String?      @db.Uuid // → products.id: produto que originou a empresa (FASE 3)
  groupId             String?      @db.Uuid // → business_groups.id: Grupo Empresarial (Caderno Tela 06; F1)
  // Cadastro do CNPJ (Caderno Tela 06 · Incluir).
  cnpj                String? // CNPJ da empresa (só dígitos)
  headquarterType     String? // MATRIZ | FILIAL
  internalResponsible String? // responsável interno pela conta
  // Autorizações de uso na Base CRIVO / prova social (Tela 09 · opt-in por empresa).
  consentAnonymized   Boolean      @default(false) // uso de dados anonimizados
  consentBenchmark    Boolean      @default(false) // participar do benchmark agregado
  consentCase         Boolean      @default(false) // virar case (autorizado)
  consentLogo         Boolean      @default(false) // uso do logo em vitrine
  consentTestimonial  Boolean      @default(false) // depoimento público
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([groupId])
  @@map("tenants")
}

// Grupo Empresarial (Caderno Tela 06 — Grupo → CNPJ → Unidade). Control plane:
// camada leve ACIMA do tenant. Cada CNPJ é um tenant próprio (o isolamento RLS
// existente garante dados separados por CNPJ); o grupo apenas agrupa tenants
// para gestão e, nas fases seguintes, visão consolidada autorizada (F2/F3).
// Sem relation Prisma (padrão desacoplado do control plane, como productId).
model BusinessGroup {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  // F3: "consolidado contratado/autorizado" (Caderno Tela 06) — só com true o
  // portal do cliente libera a visão consolidada do grupo.
  consolidatedEnabled Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("business_groups")
}

// F3: e-mails autorizados a ver o consolidado do grupo no PORTAL do cliente
// (Admin de Grupo). Sem relation Prisma (padrão desacoplado); cascade no código.
model BusinessGroupAccess {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid // → business_groups.id
  email     String // e-mail do usuário do tenant (normalizado minúsculo)
  createdAt DateTime @default(now())

  @@unique([groupId, email])
  @@index([email])
  @@map("business_group_access")
}

// Relatório Preliminar CRIVO (Briefing §5, Portal §7).
// Control plane: gerado a partir de PlatformLead (Diagnóstico Inicial preenchido
// na LP). Conteúdo produzido pela IA (mesmo provider do Copiloto) a partir do
// snapshot do diagnóstico. Envio por e-mail é best-effort (graceful fallback).
// Sem RLS por tenant — não pertence a um tenant; pertence ao funil do super admin.
model PreliminaryReport {
  id             String @id @default(uuid()) @db.Uuid
  platformLeadId String @db.Uuid // → platform_leads.id (sem relation Prisma para manter desacoplado)

  // Snapshot do diagnóstico no momento da geração (imutável, mesmo se o lead
  // refizer o diagnóstico depois).
  diagnosticScore      Int
  diagnosticLevel      String // INICIAL | EM_ESTRUTURACAO | ESTRUTURADO | AVANCADO
  diagnosticDimensions Json // Record<PreDiagnosticDimension, number>
  topAttention         String

  // Conteúdo do relatório (markdown), modelo usado e versão do prompt.
  content       String
  modelVersion  String // ex: gpt-4o-mini / claude-sonnet-4-6
  promptVersion String @default("v1")

  status      PreliminaryReportStatus @default(GERANDO)
  errorReason String?

  // Envio por e-mail.
  sentTo        String? // endereço do destinatário
  sentAt        DateTime?
  emailProvider String? // resend | smtp | stub

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformLeadId])
  @@index([status])
  @@map("preliminary_reports")
}

// Mentoria de líder (Briefing §10, Matriz §Mentorias). Vinculada a um tenant
// (ID lógico, sem relation Prisma para manter control plane desacoplado).
// Super Admin agenda, controla formato/quantidade/status; o cliente vê o
// histórico/calendário (próxima fatia da UI do tenant).
model Mentoria {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid // → organizations.id (sem relation)
  title        String
  format       MentoriaFormat @default(ONLINE)
  mentorName   String
  // Líder/colaborador convidado — armazenado como string (e-mail/nome) para
  // permitir mentoria de pessoas que ainda não estão no app.
  attendee     String
  scheduledAt  DateTime
  durationMin  Int            @default(60)
  meetingUrl   String? // para ONLINE
  location     String? // para PRESENCIAL
  status       MentoriaStatus @default(AGENDADA)
  notes        String?
  recordingUrl String? // gravação / ata após realizada
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId])
  @@index([scheduledAt])
  @@index([status])
  @@map("mentorias")
}

// Biblioteca de Ações (Matriz §Plano de Ação): catálogo GLOBAL de ações
// modelo que o RH/CEO da empresa pode IMPORTAR para o próprio plano. Sem RLS.
// Cada ação carrega categoria, responsável-tipo (não pessoa nominal),
// evidência esperada e prazo padrão para revisão.
model ActionTemplate {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String
  category             String // Pessoas | Operação | Cultura | Cliente | Compliance | …
  description          String?
  suggestedResponsible String? // ex: "RH", "Gestor da área", "Liderança direta"
  expectedEvidence     String? // ex: "Ata da reunião", "Plano publicado no Confluence"
  defaultReviewDays    Int      @default(30)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@map("action_templates")
}

// Textos editáveis (copy do produto): key-value de strings/blobs longos que o
// Super Admin pode editar SEM precisar de deploy. Casos típicos: rodapé do
// Relatório Preliminar, e-mail de boas-vindas, parágrafos legais. `key` é
// estável; `version` permite rollback.
model EditableText {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // ex: "EMAIL_WELCOME_BODY"
  category  String   @default("geral") // emails | legais | onboarding | reports …
  content   String // texto/markdown
  version   Int      @default(1)
  updatedBy String? // e-mail do super admin que editou
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("editable_texts")
}

// Conteúdo GLOBAL da Academia CRIVO (control plane). Distinto do LibraryItem
// (que é por-tenant). Super admin cura cursos/vídeos/trilhas DISPONÍVEIS para
// todos os clientes Premium. Cliente pode IMPORTAR (gera LibraryItem na sua
// biblioteca) ou apenas referenciar pelo ID.
model GlobalAcademyContent {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  kind        String // curso | video | trilha | ebook | artigo | podcast
  description String?
  url         String?
  category    String?
  tags        String[] @default([])
  // Carga (minutos) e nível (BASICO | INTERMEDIARIO | AVANCADO) — layout do
  // card da Academia (protótipo). Opcionais: conteúdo antigo continua válido.
  durationMin Int?     @map("duration_min")
  level       String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([kind])
  @@map("global_academy_content")
}

// Trilha de auditoria das ações de plataforma (F2). Control plane: owner-only
// (sem RLS por tenant; crivo_app sem acesso). tenantId null = ação global de
// super admin. Append-only na prática (escrita best-effort pelo módulo Admin).
// Telemetria do motor de IA (control plane, owner-only como o audit_log).
// UMA linha por chamada real ao provedor — tokens/latência/erro. Alimenta as
// abas "Consumo e Limites" e "Versões e Logs" da seção IA da Plataforma.
/// Modelo de relatório do Motor 4, VINCULADO a um instrumento do Motor de
/// Diagnósticos (cultura, NR-1, IA, governança…). O super admin cadastra aqui e
/// o relatório passa a ficar disponível no portal das empresas que aplicaram
/// aquele diagnóstico — o conteúdo é montado com o resultado real do motor.
/// Control-plane (catálogo global), owner-only como products.
model ReportTemplate {
  id                String               @id @default(uuid()) @db.Uuid
  key               String               @unique // usado como tipo do documento (kebab-case)
  name              String
  description       String?              @db.Text
  instrumentSlug    String               @map("instrument_slug")
  instrument        DiagnosticInstrument @relation(fields: [instrumentSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  /// Seções fixas de texto: [{ heading, body }] — contexto/metodologia/limites.
  sections          Json                 @default("[]")
  /// Corpo FIEL do arquivo importado (.docx), já sanitizado, com os trechos
  /// dinâmicos marcados com {{chave}}. Null = modelo antigo, gerado por `sections`.
  html              String?              @db.Text
  /// O que o motor injeta automaticamente no documento.
  includeResults    Boolean              @default(true) @map("include_results") // score + faixa
  includeDimensions Boolean              @default(true) @map("include_dimensions") // tabela por dimensão
  includePlan       Boolean              @default(false) @map("include_plan") // ações do Plano de Evolução
  active            Boolean              @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([instrumentSlug])
  @@map("report_templates")
}

model AiCallLog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @db.Uuid // null = chamada sem tenant (ex.: relatório de lead da LP)
  useCase          String // copiloto | preliminary_report | pocket_summary | people_analytics
  model            String
  ok               Boolean
  errorReason      String?  @map("error_reason")
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  latencyMs        Int      @map("latency_ms")
  /// Rastreabilidade do contexto do cliente (módulo contexto): quais
  /// documentos autorizados/diretrizes entraram no prompt desta chamada.
  meta             Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId])
  @@index([useCase])
  @@map("ai_call_logs")
}

/// F3 Pacote de Templates — TEXTOS APROVADOS dos documentos (decisão 1-A do
/// cliente): a IA gera um rascunho, a equipe CRIVO edita e APROVA no Super
/// Admin, e só o texto aprovado entra nos documentos emitidos. 1 linha por
/// (empresa, documento, campo). Tem tenantId mas é gerida pelo control plane
/// (fila de aprovação cross-tenant) → owner-only, como mentorias/ai_call_logs.
model ApprovedText {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  docType  String @map("doc_type") // relatorio_executivo | dossie_tecnico | relatorio_evolucao
  field    String // sintese_executiva | sinais_leitura | proximo_passo_justificativa | finalidade_limites | conclusao_tecnica | ...

  draft      String?   @db.Text // último rascunho (da IA ou salvo pela equipe)
  draftModel String?   @map("draft_model") // modelo de IA que gerou (null = manual)
  draftAt    DateTime? @map("draft_at")

  approvedContent String?   @map("approved_content") @db.Text // texto congelado que entra no documento
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  status          String    @default("RASCUNHO") // RASCUNHO | APROVADO

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, docType, field])
  @@index([tenantId])
  @@map("approved_texts")
}

/// F4 Pacote de Templates — CICLO FORMAL de diagnóstico (decisão do cliente:
/// "ciclo = aplicação formal aberta e encerrada"). No encerramento o ciclo
/// congela um SNAPSHOT imutável (fatores do plano com risco derivado +
/// evidências + contexto psicossocial do período) que alimenta o TPL-003 —
/// a comparação entre ciclos usa sempre o dado congelado, nunca recalcula.
/// Data-plane: RLS FORCE + policy por tenant (na migração + rls.sql).
/// Nota: a migração cria também um ÍNDICE ÚNICO PARCIAL (tenantId WHERE
/// status='ABERTO') — invariante "1 ciclo aberto por vez" garantido no banco
/// (o Prisma não modela índice parcial; vive só no SQL da migração).
model DiagnosticCycle {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  org      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label    String
  status   String       @default("ABERTO") // ABERTO | ENCERRADO

  openedAt DateTime  @default(now()) @map("opened_at")
  openedBy String?   @map("opened_by")
  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by")

  method             String?
  methodologyVersion String? @map("methodology_version")
  /// Congelado no encerramento: { factors[], planTitle, planValidatedAt, psychosocial }
  snapshot           Json?

  @@index([tenantId])
  @@map("diagnostic_cycles")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid // null = ação de super admin (global)
  actorId    String?
  actorEmail String?
  action     String // tenant.provision | tenant.suspend | tenant.activate | tenant.delete | admin.login
  target     String? // id/slug do alvo
  meta       Json?
  at         DateTime @default(now())

  @@index([tenantId])
  @@index([at])
  @@map("audit_log")
}

// =====================================================================
// PRODUTOS (núcleo product-driven) — TUDO nasce de um Produto. Um produto
// define preço, limites, módulos liberados, o INSTRUMENTO de diagnóstico
// (perguntas editáveis) e a configuração de IA dos líderes. Ao converter um
// lead em cliente, a empresa é provisionada A PARTIR do produto contratado.
// Control plane (owner-only): catálogo global, fora da RLS por tenant.
// Ver diretriz estrutural 2026-06 (Super Admin product-driven).
// =====================================================================
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique // pre-diagnostico-crivo, crivo-enterprise…
  name        String
  description String?
  status      ProductStatus @default(DRAFT)
  plan        Plan? // plano-base herdado pela empresa (opcional)

  // Dados gerais / comercial
  monthlyPriceCents Int     @default(0) // valor mensal (centavos)
  setupPriceCents   Int     @default(0) // valor de implantação (centavos)
  maxUsers          Int     @default(0) // 0 = ilimitado
  maxLeaders        Int     @default(0) // 0 = ilimitado
  companyType       String? // tipo de empresa atendida

  // Módulos liberados: códigos do ModuleCatalog habilitados por este produto.
  modules Json @default("[]") // string[] de moduleCode

  // Método CRIVO deste produto + saídas técnicas que ele pode gerar (Briefing §4).
  // coreModules = liberados automaticamente na contratação (CORE da Matriz).
  method           DiagnosticMethod?
  coreModules      Json              @default("[]") // string[] de moduleCode (CORE)
  supportedOutputs Json              @default("[]") // TechnicalOutput[] suportados

  // Instrumento de diagnóstico EDITÁVEL (não fixo): blocos, categorias,
  // dimensões, escalas de resposta, pesos e perguntas. Cada produto tem o seu.
  // { dimensions:[{key,label}], scales:[{key,label,options:[{value,label}]}],
  //   blocks:[{key,label}], questions:[{id,text,block,dimension,scale,weight,inverse}] }
  diagnostic Json?

  // Configuração da IA dos líderes (por produto).
  // { prompt, knowledgeBase, rules, limitations, objective, documents:[] }
  aiConfig Json?

  // Produto de captura (pré-diagnóstico): só LP/formulário/lead — SEM portal,
  // SEM app, SEM IA. Usado pelo funil comercial da CRIVO.
  isLeadCapture Boolean @default(false)

  // Vitrine comercial (mockup do cliente 14/07): campos de apresentação do card.
  category           String? // subtítulo/categoria (ex.: "Diagnóstico organizacional")
  coreDelivery       String? // "Core da entrega" — resumo destacado no topo do card
  implementation     String? // implantação (ex.: "Imediata", "Padrão · 30 dias")
  priceLabel         String? // rótulo livre de preço (sobrepõe o valor derivado)
  modalities         String[] @default([]) // chips "Modalidades"
  suggestedModules   String[] @default([]) // chips "Módulos técnicos sugeridos" (texto livre; ≠ modules de acesso)
  suggestedAddons    String[] @default([]) // chips "Adicionais sugeridos" (texto livre)
  compatiblePackages String[] @default([]) // chips "Adicionais/Pacotes compatíveis"

  // Enquadramento comercial da solução (Caderno Tela 03 — Incluir).
  appearsOnLp        Boolean  @default(false) // aparece na LP / vitrine comercial
  sellableStandalone Boolean  @default(true) // pode ser vendida isolada
  canBeAddon         Boolean  @default(false) // pode ser adicional de outra solução
  allowsAi           Boolean  @default(false) // permite IA padrão
  allowsCustomAi     Boolean  @default(false) // permite IA personalizada
  allowedAddons      String[] @default([]) // adicionais permitidos (moduleCode)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// =====================================================================
// CRM DO SUPER ADMIN — funil comercial da CRIVO. O lead nasce do Diagnóstico
// Inicial da Landing Page (ou cadastro manual) e pertence ao SUPER ADMIN, não
// a uma empresa. Control plane (owner-only). Ao fechar a venda, é convertido
// em Tenant (convertedTenantId) provisionando a empresa pelo produto.
// =====================================================================
model PlatformLead {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  company        String?
  email          String?
  phone          String?
  segment        String?
  employeesCount String? // faixa ("51-200") ou número informado
  origin         String? // lp-diagnostico | qrcode | indicacao | anuncio…
  productId      String? @db.Uuid // produto de origem (ex.: pré-diagnóstico)

  // ATRIBUIÇÃO (§11/§15 dos Ajustes Finais do Site): de onde o visitante veio e
  // QUAL CAMPANHA gerou este lead. Colunas nomeadas — e não um JSON — porque o
  // comercial precisa AGRUPAR ("quantos leads vieram da campanha X"), e JSON não
  // se agrupa bem. Capturados na PRIMEIRA visita da sessão no site, então quem
  // navega antes de converter não perde a origem.
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent  String? @map("utm_content")
  utmTerm     String? @map("utm_term")
  referrer    String? // origem externa quando não há UTM (busca, indicação)
  landingPage String? @map("landing_page") // 1ª página da sessão

  // Enriquecimento por CNPJ (BrasilAPI) — base do grau de risco (NR-1).
  cnpj      String? // só dígitos
  cnpjData  Json? // razão social, CNAE, porte, situação, endereço, sócios…
  riskGrade String? // grau de risco preliminar: BAIXO | MEDIO | ALTO

  // Resultado do pré-diagnóstico (leitura preliminar — não é ICD oficial).
  diagnosticScore  Int? // 0–100 (score geral)
  diagnosticResult Json? // { score, level, byDimension, topConcern, recommendation }

  stage              PlatformLeadStage @default(NOVO)
  notes              String?
  lostReason         String? // motivo de perda estruturado (só quando stage=PERDIDO)
  archivedAt         DateTime?         @map("archived_at") // saiu do kanban (jornada concluída) — call 14/07
  firstContactedAt   DateTime? // 1º contato registrado — mede o tempo de resposta
  interestProductId  String?           @db.Uuid // solução de interesse (pré-venda; ≠ productId de origem)
  nextActionAt       DateTime? // follow-up: data da próxima ação combinada
  nextActionNote     String? // follow-up: o que fazer na próxima ação
  commercialOwner    String? // responsável comercial (CRIVO) pelo lead
  proposedValueCents Int? // valor proposto (centavos)
  proposalSentAt     DateTime? // quando a proposta comercial foi enviada
  potentialAddons    String[]          @default([]) // adicionais/módulos potenciais (pré-venda)
  convertedTenantId  String?           @db.Uuid // tenant criado na conversão (FASE 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([createdAt])
  @@index([utmCampaign]) // relatório "leads por campanha"
  @@map("platform_leads")
}

/// Origem/canal do lead CADASTRADA pelo super admin (Governança · Origens e Canais).
///
/// `PlatformLead.origin` continua STRING LIVRE — nada aqui vira chave estrangeira.
/// Esta tabela é o CATÁLOGO do seletor, não uma restrição: leads antigos com origem
/// fora da lista continuam válidos e continuam sendo exibidos, exatamente como antes.
///
/// As 7 origens canônicas (`PLATFORM_LEAD_ORIGINS`, em @crivo/types) NÃO foram movidas
/// para cá: seguem no código como base fixa e aparecem na lista como embutidas, não
/// removíveis. Esta tabela guarda apenas o que for cadastrado ALÉM delas — mesmo
/// desenho do catálogo de Adicionais, onde o banco complementa a lista fixa.
model PlatformLeadOriginOption {
  id     String  @id @default(uuid()) @db.Uuid
  value  String  @unique // código gravado em platform_leads.origin (ex.: INSTAGRAM)
  label  String // rótulo exibido no seletor e nos painéis (ex.: Instagram)
  active Boolean @default(true) // some do seletor SEM apagar a origem dos leads antigos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_lead_origins")
}

// =====================================================================
// CONTRATO (Briefing §11 + Matriz §Super Admin) — o que a CRIVO configura por
// cliente SEM programação: produto, modelo, prazo, rodadas, respondentes,
// líderes, integração técnica (AEP/PGR), módulos opcionais, responsável e
// status. Control plane (owner-only). Um contrato ATIVO por empresa; histórico
// permitido. O portal libera menus a partir do produto (CORE) + opcionais.
// =====================================================================
model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @db.Uuid // → organizations.id (empresa-cliente) — null se contrato de GRUPO
  groupId        String?        @db.Uuid // → business_groups.id — contrato de GRUPO (Tela 05 [5]); exclusivo com organizationId
  productId      String?        @db.Uuid // → products.id (solução principal; = solutionIds[0])
  solutionIds    String[]       @default([]) // soluções contratadas (Tela 05: várias por contrato)
  model          ContractModel  @default(PONTUAL)
  status         ContractStatus @default(RASCUNHO)

  // Método é herdado do produto, mas pode ser sobrescrito por contrato.
  method          DiagnosticMethod?
  // Saída técnica define os documentos gerados — independente do método.
  technicalOutput TechnicalOutput   @default(SEM_INTEGRACAO)

  startDate      DateTime?
  endDate        DateTime?
  accessDays     Int? // prazo de acesso (dias) — alternativa a endDate
  rounds         Int       @default(1) // rodadas/ciclos/pulsos
  maxRespondents Int       @default(0) // 0 = ilimitado
  maxLeaders     Int       @default(0)
  // Horas de mentoria contratadas no ciclo (Programas › Mentorias e Agenda,
  // KPI "Horas contratadas"). null = não informado no contrato.
  contractedHours Int? @map("contracted_hours")

  // Módulos opcionais ativados além do CORE do produto (códigos do ModuleCatalog).
  optionalModules Json    @default("[]")
  responsible     String? // responsável CRIVO pelo contrato
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([groupId])
  @@index([status])
  @@map("contracts")
}

/// Adicional precificado (Caderno Tela 05 · modelo Adicional c/ preço+recorrência).
/// Um adicional é um módulo do catálogo com preço; entra no contrato via
/// Contract.optionalModules e no faturamento/MRR quando recurring=true.
model Addon {
  id                String  @id @default(uuid()) @db.Uuid
  moduleCode        String  @unique // código do ModuleCatalog OU slug próprio (crivo-plus…)
  label             String // nome comercial do adicional
  monthlyPriceCents Int     @default(0) // preço mensal (centavos) — conta no MRR se recurring
  setupPriceCents   Int     @default(0) // preço de implantação/único (centavos)
  recurring         Boolean @default(true) // true = recorrente (MRR); false = pontual
  active            Boolean @default(true)

  // Catálogo de upsells no padrão do cliente (mockup 14/07).
  description         String? // subtítulo do adicional na tabela
  category            String? // ex.: "Pacote transversal", "Governança IA", "Serviço"
  recurrence          AddonRecurrence @default(MENSAL) // mantém `recurring` em sincronia
  priceLabel          String? // rótulo livre (ex.: "R$ 900 / dossiê")
  compatibleSolutions String[]        @default([]) // chips de soluções compatíveis
  activatedModules    String[]        @default([]) // códigos exibidos (mod-ia, mod-people…)
  limitsNote          String? // coluna "Limites"
  dependenciesNote    String? // coluna "Dependências"
  releaseRule         String? // coluna "Regra de liberação"
  statusEx            AddonStatus     @default(ATIVO) // mantém `active` em sincronia

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addons")
}

// Recorrência do adicional (tabela do cliente): mensal entra no MRR.
enum AddonRecurrence {
  MENSAL
  POR_CICLO
  UNICO
  POR_SESSAO
}

// Estado do adicional na tabela do cliente.
enum AddonStatus {
  ATIVO
  EM_REVISAO
  AGUARDANDO_DADOS
}

// =====================================================================
// CONFIGURAÇÃO DE IA (Super Admin · auditoria 2.3.1) — token OpenAI/ChatGPT
// configurável SEM código, CRIPTOGRAFADO em repouso (AES-256-GCM com chave
// derivada de AUTH_SECRET). Singleton (scope='global'). Control plane
// (owner-only): nenhum usuário comum lê o token. Prompts por produto vivem em
// Product.aiConfig; aqui ficam token, modelo, ativação e módulos habilitados.
// =====================================================================
/// Configuração do Motor (singleton scope='global') — regras GLOBAIS de como o
/// motor de diagnósticos funciona, definidas pelo Super Admin e que tomam efeito:
/// limiar de anonimato, modo de cálculo padrão, régua padrão e escala padrão dos
/// novos diagnósticos. Não é um portal de atalhos — é onde se DEFINE o motor.
model EngineConfig {
  id                               String              @id @default(uuid()) @db.Uuid
  scope                            String              @unique @default("global")
  // Mínimo de respondentes para revelar qualquer agregado (proteção de anonimato).
  minRespondents                   Int                 @default(5) @map("min_respondents")
  // Padrões aplicados ao criar um novo diagnóstico.
  defaultAggregation               ScoreAggregation    @default(MEDIA_PONDERADA) @map("default_aggregation")
  defaultBandKind                  MethodologyBandKind @default(MATURITY) @map("default_band_kind")
  defaultScaleLabels               String[]            @default([]) @map("default_scale_labels")
  // Padrões do motor v3.1 aplicados a todo diagnóstico novo (Anexo D/E).
  defaultRounding                  Int                 @default(1) @map("default_rounding")
  defaultMinValidCompletionPercent Int                 @default(70) @map("default_min_valid_completion_percent")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("engine_config")
}

model AiSettings {
  id       String @id @default(uuid()) @db.Uuid
  scope    String @unique @default("global")
  provider String @default("openai")
  model    String @default("gpt-4o-mini")

  // Token criptografado (nunca em claro no banco nem na API de leitura).
  apiKeyEnc  String? // ciphertext base64
  apiKeyIv   String? // IV base64
  apiKeyTag  String? // auth tag base64 (GCM)
  apiKeyHint String? // últimos 4 chars, p/ exibir mascarado

  enabled        Boolean   @default(false)
  enabledModules Json      @default("[]") // string[] de moduleCode que podem usar IA
  lastStatus     String? // ok | invalid | error | rate_limited | untested
  lastTestedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

// IA — CENTRAL DE PROMPTS (Caderno §10 · P0-c). Prompt técnico por caso de uso,
// editável e versionado em "Configurações de IA". Sem linha = usa o PADRÃO em
// código (ai-prompt-defaults.ts). Control plane (super admin / owner-only).
model AiPrompt {
  id        String   @id @default(uuid()) @db.Uuid
  useCase   String   @unique // copiloto | preliminary_report | pocket_summary | people_analytics
  content   String   @db.Text
  version   Int      @default(1)
  updatedBy String? // e-mail do super admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_prompts")
}

// IA — PROMPTS PERSONALIZADOS do super admin (aba Prompts e Políticas). Prompt
// livre, opcionalmente vinculado a um diagnóstico do Motor (instrumentSlug) e a
// adicionais contratados. `addonIds` guarda moduleCode[] (não Addon.id): é o
// único identificador que o catálogo do front expõe e o único que existe para
// adicionais ainda não configurados no banco. Control plane (owner-only).
/// Plano de acao de um FATOR, escrito pela IA e GUARDADO.
///
/// E a rede de seguranca do Plano de Evolucao. A biblioteca embutida em codigo
/// e chaveada por 6 slugs fixos da metodologia psicossocial original; numa
/// metodologia montada pelo cliente (dim-1, dim-2, ...) ela nunca casa, e sem
/// IA a tela ficava com ZERO sugestao. Aqui fica o texto que a propria IA ja
/// escreveu para aquele fator: se depois ela cair, ficar sem cota ou demorar,
/// o sistema serve o ultimo texto dela em vez de nada.
///
/// NAO guarda dado de empresa: o prompt so leva o rotulo do fator e os numeros
/// de risco, entao a entrada e reaproveitavel por qualquer tenant do mesmo
/// instrumento. Por isso e control-plane (sem tenantId), como ai_custom_prompts.
model FactorActionPlan {
  id             String   @id @default(uuid()) @db.Uuid
  /// Instrumento do Motor que produziu a matriz (PSYCHOSOCIAL, essencial, ...).
  instrumentSlug String   @map("instrument_slug")
  /// Slug do fator na metodologia ativa.
  factorSlug     String   @map("factor_slug")
  /// Rotulo no momento em que foi gerado — para auditoria e para a tela.
  factorLabel    String   @map("factor_label")
  descricao      String
  objetivo       String
  /// [{ titulo, prazo, objetivo, etapas, indicadores }]
  acoes          Json
  /// Quem escreveu: IA hoje; deixa espaco para revisao humana depois.
  origin         String   @default("IA")
  generatedAt    DateTime @default(now()) @map("generated_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([instrumentSlug, factorSlug])
  @@index([instrumentSlug])
  @@map("factor_action_plans")
}

model AiCustomPrompt {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  body            String   @db.Text
  // Um prompt pode servir a VÁRIOS diagnósticos (ex.: a mesma política para o
  // Essencial e o Organizacional). `instrumentSlug` continua existindo como
  // espelho do primeiro item — nenhuma linha antiga precisa ser reescrita.
  instrumentSlug  String?  @map("instrument_slug") // PRE_DIAGNOSTIC | PSYCHOSOCIAL | slug custom
  instrumentSlugs String[] @default([]) @map("instrument_slugs")
  addonIds        Json     @default("[]") @map("addon_ids") // moduleCode[] dos adicionais
  active          Boolean  @default(true)
  updatedBy       String?  @map("updated_by")

  files AiCustomPromptFile[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_custom_prompts")
}

// Material de referência anexado a um prompt personalizado. Guarda só o TEXTO
// extraído (pdf/docx/xlsx/txt/md/csv) — o binário original não é persistido.
model AiCustomPromptFile {
  id            String         @id @default(uuid()) @db.Uuid
  promptId      String         @map("prompt_id") @db.Uuid
  prompt        AiCustomPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  extractedText String         @map("extracted_text") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("ai_custom_prompt_files")
}

// =====================================================================
// RBAC DINÂMICO (F3) — catálogo GLOBAL de permissões (módulo:ação) e papéis
// de sistema. Sem RLS por tenant (catálogo compartilhado entre todas as
// empresas); SOMENTE-LEITURA para o app — escrita só via seed/owner (rls.sql).
// Papéis customizados POR empresa e atribuição multi-papel (UserRole) entram
// na próxima fatia. Ver docs/SAAS-TRANSFORMATION.md §6.
// =====================================================================

model Permission {
  id     String           @id @default(uuid()) @db.Uuid
  code   String           @unique // "leads:view"
  module String // leads
  action String // view | create | edit | delete | export | submit
  label  String
  roles  RolePermission[]

  @@map("permissions")
}

model RoleDef {
  id       String           @id @default(uuid()) @db.Uuid
  code     String           @unique // espelha o enum Role: ADMIN, CEO, GESTOR, RH, LIDER, JURIDICO, COLABORADOR
  name     String
  isSystem Boolean          @default(true)
  perms    RolePermission[]

  @@map("role_defs")
}

model RolePermission {
  roleId String     @db.Uuid
  permId String     @db.Uuid
  role   RoleDef    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  perm   Permission @relation(fields: [permId], references: [id], onDelete: Cascade)

  @@id([roleId, permId])
  @@map("role_permissions")
}

// =====================================================================
// PLANOS + MÓDULOS (F4) — catálogo GLOBAL de módulos da plataforma e a
// ativação por empresa. ModuleCatalog é compartilhado (sem RLS por tenant,
// SOMENTE-LEITURA p/ o app, como o catálogo RBAC). TenantModule é DATA PLANE
// (RLS por tenant): o app lê os módulos da própria empresa via forTenant; a
// ESCRITA é owner-only (super admin), para uma empresa não auto-habilitar
// módulos que não contratou. Ver docs/SAAS-TRANSFORMATION.md §4.
// =====================================================================

model ModuleCatalog {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // dashboard | icd | crm | relatorios | ...
  name      String
  category  String
  minPlan   Plan     @default(BASE) // plano mínimo p/ habilitar
  createdAt DateTime @default(now())

  // Campos EDITORIAIS da seção "Módulos Técnicos" do Super Admin (protótipo
  // Lovable, Catálogo Comercial). São texto informativo para a equipe CRIVO —
  // nada aqui é regra executável: quem libera módulo continua sendo
  // Solução/Adicional → Contrato ATIVO → tenant_modules. code/name/category/
  // minPlan seguem sincronizados com MODULES (@crivo/types) pelo seed e pelo PUT.
  description      String? // o que o módulo faz (descrição funcional)
  dependenciesNote String? // de quais outros módulos depende (texto livre)
  permissionsNote  String? // quem pode acessá-lo (papéis), texto livre
  releaseRule      String? // regra técnica que o ativa num contrato (texto livre)
  status           ModuleCatalogStatus @default(ATIVO)
  updatedAt        DateTime            @default(now()) @updatedAt

  @@map("module_catalog")
}

// Maturidade de um módulo técnico no catálogo interno (informativo).
enum ModuleCatalogStatus {
  ATIVO
  BETA
  INTERNO
}

// Domínios próprios por empresa (F5). A resolução por domínio acontece ANTES
// de conhecer o tenant (pré-login), então tenant_domains é CONTROL PLANE:
// acesso só via owner (crivo_app revogado no rls.sql). organizationId liga ao
// data plane (sem relation Prisma p/ manter o desacoplamento, como Tenant).
model TenantDomain {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid // → organizations.id (data plane)
  domain            String    @unique // app.clientex.com | clientex.crivolegacy.com.br
  verified          Boolean   @default(false)
  primary           Boolean   @default(false)
  // Token TXT que o cliente deve publicar em _crivo.<domain> para provar posse.
  // Gerado na criação do registro (32 hex chars), nunca regenerado em prod.
  verificationToken String? // null em domínios legados pré-#55; preenchido em novos
  verifiedAt        DateTime?
  lastVerifyAttempt DateTime?
  lastVerifyError   String? // razão do último insucesso (lookup, mismatch, timeout)
  createdAt         DateTime  @default(now())

  @@index([organizationId])
  @@map("tenant_domains")
}

// White-label (F5): identidade visual por empresa. 1:1 com Organization.
// Data plane (RLS por tenant): a plataforma lê a própria via forTenant; a
// escrita é owner-only (super admin define), como tenant_modules. As cores
// sobrescrevem os tokens --crivo-* (primária = azul-profundo, acento = terra).
model TenantBranding {
  tenantId     String       @id @db.Uuid
  org          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl      String?
  faviconUrl   String?
  primaryColor String? // hex, sobrescreve --crivo-azul-profundo
  accentColor  String? // hex, sobrescreve --crivo-terra
  emailFrom    String?
  whatsapp     String?
  footerText   String?
  updatedAt    DateTime     @updatedAt

  @@map("tenant_branding")
}

// Biblioteca & Formação: conteúdo (materiais/cursos) por empresa. Data plane
// (RLS por tenant): a empresa vê/gere o próprio acervo. Escrita gateada por
// `library:manage` na API; leitura por `library:view`.
model LibraryItem {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  org         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  kind        String // artigo | podcast | ebook | curso | framework
  url         String?
  // Carga (minutos) e nível — mesmos campos do catálogo global; import-global copia.
  durationMin Int?         @map("duration_min")
  level       String? // BASICO | INTERMEDIARIO | AVANCADO
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@map("library_items")
}

// Metering (F4): contadores de uso por empresa/métrica/período (YYYY-MM).
// Data plane (RLS por tenant): o app incrementa sob forTenant. Base p/ billing
// e enforcement de limites de plano (PLAN_LIMITS).
model UsageCounter {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric    String // leads | api_calls | active_users
  period    String // YYYY-MM
  value     BigInt       @default(0)
  updatedAt DateTime     @updatedAt

  @@unique([tenantId, metric, period])
  @@index([tenantId])
  @@map("usage_counters")
}

// Quais módulos a empresa ativou. PK composta (tenant + módulo). tenantId =
// organizationId (data plane). config reservado p/ parametrização por módulo.
model TenantModule {
  tenantId   String       @db.Uuid
  org        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleCode String
  enabled    Boolean      @default(true)
  config     Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@id([tenantId, moduleCode])
  @@index([tenantId])
  @@map("tenant_modules")
}

// =====================================================================
// TENANCY — Organization é o tenant raiz (holding). Todo registro de
// negócio carrega tenantId = organizationId e é protegido por RLS.
// =====================================================================

model Organization {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  plan                Plan                 @default(BASE)
  // Dados cadastrais (autoatendimento na tela "Organização" do portal).
  legalName           String? // razão social
  taxId               String? // CNPJ
  // F2 (Pacote de Templates): cabeçalho do Dossiê Técnico — preenchidos pela
  // própria empresa na tela "Minha Organização" (decisão do cliente 27/07).
  establishment       String? // unidade/estabelecimento avaliado
  employeesCount      String?              @map("employees_count") // nº de empregados (número ou faixa)
  workModel           String?              @map("work_model") // presencial | híbrido | remoto | misto
  website             String?
  phone               String?
  // Slug público do Questionário Psicossocial (Briefing §6): link anônimo sem
  // login (/q/<slug>), opcionalmente por setor via query. Único entre empresas.
  /// Mínimo de respondentes para liberar resultados agregados NESTA empresa.
  /// null = usa o padrão global da Configuração do Motor (5). Existe para a
  /// microempresa (ex.: 3 funcionários), onde o padrão nunca liberaria nada.
  minRespondents      Int?                 @map("min_respondents")
  psychosocialSlug    String?              @unique
  diagnosticLinks     DiagnosticLink[]
  diagnosticResponses DiagnosticResponse[]
  collaborators       Collaborator[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  companies             Company[]
  units                 Unit[]
  teams                 Team[]
  users                 User[]
  cycles                AssessmentCycle[]
  assessments           Assessment[]
  responses             Response[]
  icdScores             IcdScore[]
  leads                 Lead[]
  modules               TenantModule[]
  usage                 UsageCounter[]
  branding              TenantBranding?
  library               LibraryItem[]
  actionPlans           ActionPlan[]
  actionItems           ActionItem[]
  evidences             Evidence[]
  selfAssessments       SelfAssessment[]
  essentialRecords      EssentialRecord[]
  pareceres             Parecer[]
  psychosocialResponses PsychosocialResponse[]

  // Anexo ICD do Líder v1 — Registro de Decisão (task #45).
  decisionCategories  DecisionCategory[]
  decisionIcdScores   DecisionIcdScore[]
  icdCycles           IcdCycle[]
  leaderQuarterlyIcd  LeaderQuarterlyIcd[]
  companyQuarterlyIcd CompanyQuarterlyIcd[]
  affectedAudiences   AffectedAudience[]
  decisions           Decision[]
  sustentationActions SustentationAction[]
  PocketSession       PocketSession[]
  PocketReflection    PocketReflection[]
  PocketAiSummary     PocketAiSummary[]
  TenantRole          TenantRole[]
  reportEmissions     ReportEmission[]
  actionItemHistory   ActionItemHistory[]
  devolutivas         DevolutivaRecord[]
  diagnosticCycles    DiagnosticCycle[]
  CampaignInvite      CampaignInvite[]
  // Governança de IA (módulo govia) — data plane do cliente.
  aiUseCases          AiUseCase[]
  aiUseCaseDecisions  AiUseCaseDecision[]
  aiUseCaseLinks      AiUseCaseLink[]
  aiIncidents         AiIncident[]
  aiPolicies          AiPolicy[]
  // Workforce Intelligence (módulo workforce) — data plane do cliente.
  workProcesses       WorkProcess[]
  workTasks           WorkTask[]
  workSkills          WorkSkill[]
  workPilots          WorkPilot[]
  // Contexto e Diretrizes (módulo contexto) — data plane do cliente.
  tenantDirectives    TenantDirective[]
  tenantDocuments     TenantDocument[]
  tenantDocumentFiles TenantDocumentFile[]
  tenantTerms         TenantTerm[]
  tenantAiUseCases    TenantAiUseCaseContext[]
  // Radar de Custos Invisíveis — histórico congelado por ciclo.
  invisibleCostSnapshots InvisibleCostSnapshot[]

  @@map("organizations")
}

model Company {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  cnpj         String?
  createdAt    DateTime     @default(now())

  units Unit[]

  @@index([tenantId])
  @@map("companies")
}

model Unit {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String       @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  region    String?
  createdAt DateTime     @default(now())

  teams     Team[]
  documents TenantDocument[] // Contexto e Diretrizes: documentos autorizados da unidade

  @@index([tenantId])
  @@index([companyId])
  @@map("units")
}

model Team {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String       @db.Uuid
  unit      Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())

  members TeamMember[]

  @@index([tenantId])
  @@index([unitId])
  @@map("teams")
}

// =====================================================================
// IAM
// =====================================================================

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  org                Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String
  name               String
  passwordHash       String
  role               Role         @default(COLABORADOR)
  active             Boolean      @default(true)
  // Revogação de sessão (segurança): incrementar invalida TODOS os JWTs do
  // usuário (logout, troca de senha, desativação). O token carrega `tv`; o
  // AuthGuard compara com este valor a cada request.
  tokenVersion       Int          @default(0)
  // Senha definida PELA PLATAFORMA (criação do cliente, "enviar acesso" do CRM,
  // redefinição pelo super admin). Enquanto true, o portal EXIGE a troca antes de
  // liberar a navegação: a senha que trafegou por e-mail — e que fica visível na
  // tela do super admin — não pode valer indefinidamente. Volta a false quando o
  // próprio usuário define a senha (troca no portal ou recuperação por e-mail).
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  // Telas que o usuário pode acessar no portal (lista de rotas, ex.: ["dashboard","icd"]).
  // null = sem restrição (vê tudo que papel/módulo permitem). Controla a nav (F6).
  screenAccess       Json?
  // Aceite de termos/LGPD no 1º acesso (Briefing · Matriz §Confidencialidade).
  termsAcceptedAt    DateTime?
  termsVersion       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  memberships              TeamMember[]
  passwordResetTokens      PasswordResetToken[]
  assessments              Assessment[]         @relation("LeaderAssessments")
  icdScores                IcdScore[]           @relation("LeaderScores")
  // Anexo ICD do Líder v1 — decisões registradas pelo líder (task #45).
  decisions                Decision[]           @relation("LeaderDecisions")
  decisionIcdScoresMine    DecisionIcdScore[]   @relation("LeaderDecisionIcdScores")
  leaderQuarterlyIcdScores LeaderQuarterlyIcd[] @relation("LeaderQuarterlyIcdScores")
  pocketSessions           PocketSession[]      @relation("LeaderPocketSessions")
  userRoles                UserRole[] // #68 — multi-papel dinâmico

  // E-mail único POR tenant (mesmo e-mail pode existir em orgs diferentes)
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model TeamMember {
  teamId   String  @db.Uuid
  userId   String  @db.Uuid
  tenantId String  @db.Uuid
  isLeader Boolean @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([tenantId])
  @@map("team_members")
}

// =====================================================================
// AVALIAÇÕES & ICD (Fase F1)
// =====================================================================

model AssessmentCycle {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @db.Uuid
  org                  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  description          String? // contexto/instrução opcional da campanha
  sector               String? // setor/área alvo (RH, Comercial, Operações…); null = toda a empresa
  // Slug público para link de convite (Anexo Portal §7): respondentes acessam
  // /p/c/<slug> sem login. Único por tenant para evitar colisão de leituras.
  publicSlug           String?      @unique
  startsAt             DateTime? // janela opcional
  endsAt               DateTime?
  reminderAt           DateTime? // quando o sistema deve enviar lembrete (job futuro)
  reminderSentAt       DateTime? // idempotência: marca quando enviou
  status               CycleStatus  @default(OPEN)
  closedAt             DateTime?
  // Tela 08 [3]: versão de metodologia PSYCHOSOCIAL aplicada quando o ciclo foi
  // aberto — garante rastreabilidade/comparabilidade do score mesmo se a
  // metodologia for republicada depois.
  methodologyVersionId String?      @db.Uuid
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  assessments Assessment[]
  invites     CampaignInvite[]

  @@index([tenantId])
  @@index([sector])
  @@map("assessment_cycles")
}

model Assessment {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  org       Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId   String?          @db.Uuid
  cycle     AssessmentCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  leaderId  String           @db.Uuid
  leader    User             @relation("LeaderAssessments", fields: [leaderId], references: [id], onDelete: Cascade)
  type      AssessmentType   @default(ICD)
  createdAt DateTime         @default(now())

  response Response?
  score    IcdScore?

  @@index([tenantId])
  @@index([leaderId])
  @@map("assessments")
}

model Response {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  org          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentId String       @unique @db.Uuid
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers      Json // [{ questionId, value }]
  submittedAt  DateTime     @default(now())

  @@index([tenantId])
  @@map("responses")
}

// Resposta ao Questionário Psicossocial Organizacional (Briefing §6 — diagnóstico
// AMPLO por colaborador). ANÔNIMA por design (§11/§14): NÃO há vínculo com User.
// Guarda só tenant + setor + respostas + score agregável. Confidencialidade é
// garantida na agregação (supressão < 5 respondentes por recorte).
model PsychosocialResponse {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @db.Uuid
  org                  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sector               String? // setor/área (RH, Comercial…); null = não informado
  /// Retrato dos recortes do colaborador no envio (unidade, área, setor, cargo,
  /// turno, GHE, gestor, modelo, gênero, faixa etária, geração) — nunca um
  /// identificador. É por ele que Dossiê e portal agrupam, com supressão.
  cohort               Json?
  answers              Json // [{ questionId, value }] — 12 itens, escala 1–5
  score                Float // 0–100 (proteção geral; maior = menor risco); decimal desde 2026-09-16 (1 casa nos scores)
  level                String // BAIXO | MODERADO | ALTO | CRITICO
  byDimension          Json // { demandas, controle, apoio, reconhecimento, clareza, relacoes } 0–100
  /// { <slug do fator>: 0-100 } — média das perguntas vinculadas ao fator, para a
  /// PROBABILIDADE da Matriz de Risco. null = respondido antes de existirem
  /// fatores; nesse caso a resposta é IGNORADA no cálculo do fator (nunca 0).
  byFactor             Json?        @map("by_factor")
  /// Campanha (ciclo) em que esta resposta foi coletada. null = coleta avulsa
  /// (link aberto ou autoavaliacao). E o que permite medir adesao e evolucao
  /// POR CICLO — antes nenhuma resposta sabia a que campanha pertencia.
  cycleId              String?      @map("cycle_id") @db.Uuid
  // MET1 — versão de metodologia PSYCHOSOCIAL que EFETIVAMENTE pontuou esta
  // resposta (pin no momento do score). Trilha de rastreabilidade: republicar a
  // metodologia não altera respostas já pontuadas. null = pontuada pelo padrão
  // embutido (sem metodologia ativa) ou resposta anterior a esta trava.
  methodologyVersionId String?      @db.Uuid
  submittedAt          DateTime     @default(now())

  @@index([tenantId])
  @@index([sector])
  @@index([methodologyVersionId])
  @@map("psychosocial_responses")
}

// =====================================================================
// COMERCIAL — Pipeline de leads (alimentado pela LP e por cadastro manual)
// =====================================================================

model Lead {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  email     String?
  whatsapp  String?
  segment   String?
  origin    String? // lp-diagnostico, lp-ebook-nr1, manual…
  stage     LeadStage    @default(NOVO)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, stage])
  @@map("leads")
}

model IcdScore {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  org             Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessmentId    String          @unique @db.Uuid
  assessment      Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  leaderId        String          @db.Uuid
  leader          User            @relation("LeaderScores", fields: [leaderId], references: [id], onDelete: Cascade)
  score           Int // 0–100
  dimensions      Json // { clareza, pressao, confianca, influencia, risco } (0–100, normalizado p/ coerência)
  dominantPattern DominantPattern
  computedAt      DateTime        @default(now())

  @@index([tenantId])
  @@index([leaderId])
  @@map("icd_scores")
}

// =====================================================================
// PLANO DE AÇÃO + EVIDÊNCIAS (Briefing §8/§9 + Matriz §Plano de Ação) — CORE de
// todo diagnóstico. Data plane (RLS por tenant). O plano final só vira documento
// após validação pela empresa/responsável (validatedAt). Ações podem ser
// sugeridas (IA/biblioteca), mas a validação é humana.
// =====================================================================
model ActionPlan {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  org                  Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                String
  source               String? // autoavaliação | escuta | questionário | observação | parecer
  /// A4 — PROVENIÊNCIA estruturada: qual diagnóstico do Motor originou o plano
  /// (FK no catálogo; `source` texto livre preservado como legado/complemento).
  sourceInstrumentSlug String?               @map("source_instrument_slug")
  sourceInstrument     DiagnosticInstrument? @relation("plan_source_instrument", fields: [sourceInstrumentSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  validatedAt          DateTime? // sem validação = minuta; com validação = documento final
  validatedBy          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  items ActionItem[]

  @@index([tenantId])
  @@map("action_plans")
}

model ActionItem {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  org                  Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId               String                @db.Uuid
  plan                 ActionPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  point                String // ponto identificado (= fator psicossocial, para o inventário §6/§15)
  origin               String? // origem do ponto (autoavaliação/escuta/questionário/observação/parecer)
  action               String // ação proposta (= medida de controle no inventário)
  responsible          String? // responsável (empresa)
  dueDate              DateTime?
  status               ActionStatus          @default(SUGERIDA)
  expectedEvidence     String? // evidência esperada
  reviewDate           DateTime? // data de revisão de efetividade
  // Inventário de fatores psicossociais (apoio ao PGR §6/§15): dimensões que
  // estruturam o ponto como fator de risco. exposedGroup = grupos expostos;
  // riskLevel = classificação (BAIXO|MEDIO|ALTO|CRITICO).
  exposedGroup         String?
  // Matriz de risco do dossiê (doc 09 §6): severidade e probabilidade são as
  // ENTRADAS; o risco técnico (Baixo/Moderado/Alto) é DERIVADO delas pela matriz
  // 3x3 — nunca digitado. `riskLevel` fica como valor legado/manual dos registros
  // anteriores e é usado só quando não há severidade+probabilidade.
  severity             String? // Baixa | Moderada | Alta
  probability          String? // Baixa | Moderada | Alta
  riskLevel            String?
  // F2 (Pacote de Templates): campos da matriz/plano oficiais. A EMPRESA informa
  // (decisão 27/07): área/processo do fator, medida que JÁ existe (nunca
  // inventada pelo sistema) e o indicador de acompanhamento da ação.
  areaProcess          String?               @map("area_process")
  existingMeasure      String?               @map("existing_measure")
  indicator            String?
  /// OBJETIVO da medida ("Reduzir sobrecarga recorrente") — coluna do Plano de
  /// Ação no modelo oficial do Dossiê. A sugestão da IA JÁ escrevia este texto
  /// e ele era descartado na hora de virar ação: o item não tinha onde guardá-lo
  /// e a coluna do documento saía vazia.
  objective            String?
  /// A4 — proveniência estruturada do fator (mesma semântica do plano).
  sourceInstrumentSlug String?               @map("source_instrument_slug")
  sourceInstrument     DiagnosticInstrument? @relation("item_source_instrument", fields: [sourceInstrumentSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  // Origem do cálculo quando a ação foi SUGERIDA pela matriz 5x5 (NR-1 §8.4).
  // Guarda o retrato de P e S do momento da geração: a matriz muda quando entram
  // novas respostas, e o item precisa manter o que o justificou. NÃO se mistura
  // com severity/probability acima, que são a matriz 3x3 preenchida pela empresa
  // — as duas réguas convivem de propósito (Anexo D `important_separation`).
  riskFactorSlug       String?               @map("risk_factor_slug")
  riskProbability      Int?                  @map("risk_probability")
  riskSeverity         Int?                  @map("risk_severity")
  /// ESCOPO da ação no Plano de Evolução único (modelo oficial do Dossiê
  /// Organizacional, 23/09): null = Resultado Geral da Organização (ação geral);
  /// valor = GHE específico, exatamente como está no retrato das respostas
  /// (cohort.ghe). Ação geral não se duplica por GHE — é referenciada no anexo
  /// de cada grupo em que o fator exige ação.
  scopeGhe             String?               @map("scope_ghe")
  /// Idempotência da sugestão (<dimensão>|<título da ação>): gerar duas vezes
  /// não duplica a ação no mesmo plano.
  suggestionKey        String?               @map("suggestion_key")
  /// Ciclo de diagnóstico que originou a ação. Fecha o rastro
  /// risco/fator -> classificação -> ação -> ciclo. Referência textual (mesmo
  /// padrão de dimensionSlug/factorSlugs): sem FK para não amarrar a exclusão
  /// de um ciclo à ação que ele originou.
  cycleId              String?               @map("cycle_id") @db.Uuid
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  evidences Evidence[]
  history   ActionItemHistory[]

  @@unique([planId, suggestionKey])
  @@index([tenantId])
  @@index([planId])
  @@map("action_items")
}

/// F2 — Trilha de alteração POR AÇÃO (TPL-004 §2 "Histórico e validação").
/// Gravada pelo próprio serviço a cada criação/alteração de item. Data-plane.
model ActionItemHistory {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  org          Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionItemId String       @map("action_item_id") @db.Uuid
  item         ActionItem   @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  change       String // resumo legível do que mudou
  changedBy    String?      @map("changed_by")
  at           DateTime     @default(now())

  @@index([tenantId])
  @@index([actionItemId])
  @@map("action_item_history")
}

/// F2 — Registro de comunicação e devolutiva (TPL-002 §10). A empresa registra
/// quando/como comunicou os resultados e medidas aos trabalhadores. Data-plane.
model DevolutivaRecord {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @db.Uuid
  org                  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date                 DateTime
  format               String // reunião | comunicado | treinamento | outro
  audience             String? // público envolvido
  topics               String? // temas comunicados
  confirmedPoints      String?      @map("confirmed_points")
  communicatedMeasures String?      @map("communicated_measures")
  createdBy            String?      @map("created_by")
  createdAt            DateTime     @default(now())

  @@index([tenantId])
  @@map("devolutiva_records")
}

// Governança de evidências (mockup do cliente 14/07): a CRIVO aprova/rejeita/
// substitui as evidências enviadas pelo cliente. ENVIADA = default ao criar.
enum EvidenceStatus {
  ENVIADA
  PENDENTE
  APROVADA
  REJEITADA
  SUBSTITUIDA
}

/// Motor de Relatórios (Motor 4, R-001) — EMISSÃO IMUTÁVEL. O preview continua
/// dinâmico; "emitir" congela o documento inteiro (conteúdo + contexto do
/// contrato) com hash e numeração sequencial por tipo. Regra v3.1: "documento
/// emitido mantém a versão usada e não é reprocessado silenciosamente".
model ReportEmission {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  org             Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            String // relatorio_preliminar | dossie_aep | dossie_aep_pgr | ...
  title           String
  emissionNumber  Int // sequencial por tenant+type (v1, v2, …)
  method          String? // método do contrato NO MOMENTO da emissão
  technicalOutput String?
  content         Json // GeneratedDocument completo (snapshot; nunca reprocessado)
  contentHash     String       @map("content_hash") // sha256 do JSON canônico
  generatedBy     String?      @map("generated_by") // e-mail de quem emitiu
  status          String       @default("EMITIDA") // EMITIDA | REVISADA
  reviewedBy      String?      @map("reviewed_by")
  reviewedAt      DateTime?    @map("reviewed_at")
  createdAt       DateTime     @default(now())

  @@unique([tenantId, type, emissionNumber])
  @@index([tenantId])
  @@index([type])
  @@map("report_emissions")
}

model Evidence {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  org             Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId          String?        @db.Uuid // vínculo opcional com a ação
  item            ActionItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  kind            String // ata | reuniao | print | foto | documento | comunicado | lista | treinamento | link
  title           String
  url             String? // link/referência (quando a evidência é um link)
  note            String?
  // Metadados do upload (quando a evidência é um arquivo, não um link). Os BYTES
  // ficam em EvidenceFile (tabela separada), p/ a linha de evidência permanecer
  // leve em listagens. fileName preenchido ⇒ há arquivo.
  fileName        String?
  fileMime        String?
  fileSize        Int? // tamanho em bytes
  file            EvidenceFile?
  // Governança (mockup 14/07): status + trilha de revisão + autor + motivo.
  status          EvidenceStatus @default(ENVIADA)
  author          String? // quem enviou (empresa/consultor) — texto livre
  reviewedAt      DateTime?      @map("reviewed_at")
  reviewedBy      String?        @map("reviewed_by")
  rejectionReason String?        @map("rejection_reason")
  supersededById  String?        @map("superseded_by_id") @db.Uuid // evidência que a substituiu
  createdAt       DateTime       @default(now())

  @@index([tenantId])
  @@index([itemId])
  @@index([status])
  @@map("evidences")
}

// Bytes do arquivo de uma evidência (1:1 com Evidence). Tabela separada para que
// os bytes NUNCA tragem em listagens de evidência — só são lidos no download.
// Data plane (RLS por tenant). Documentos pequenos (atas, prints, PDFs).
model EvidenceFile {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  evidenceId String   @unique @db.Uuid
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@map("evidence_files")
}

// =====================================================================
// PARECER CONSULTIVO CRIVO (Briefing §6) — camada HUMANA do diagnóstico. O
// consultor consolida os indicadores e redige sinais/hipóteses/prioridades/
// recomendações. Vira documento (PDF) só após publicação (publishedAt). Data
// plane (RLS por tenant). Não é gerado por IA nem promete conformidade automática.
// =====================================================================
model Parecer {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  org             Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  status          String       @default("RASCUNHO") // RASCUNHO | PUBLICADO
  context         String? // contexto/leitura da empresa
  signals         String? // sinais observados nos indicadores
  hypotheses      String? // hipóteses de trabalho
  priorities      String? // prioridades
  recommendations String? // recomendações
  author          String? // consultor responsável
  devolutivaAt    DateTime? // devolutiva agendada
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@map("pareceres")
}

// =====================================================================
// DIAGNÓSTICO ESSENCIAL (Briefing §5) — jornada simples para empresas pequenas:
// autoavaliação guiada + registro de escuta/observação → pontos de atenção que
// alimentam o Plano de Ação e o dossiê AEP/AEP+PGR. Data plane (RLS por tenant).
// =====================================================================
model SelfAssessment {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  answers   Json // [{ questionId, value }]
  score     Int // 0–100 (maturidade)
  result    Json // { score, level, byDimension, topAttention }
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@map("self_assessments")
}

model EssentialRecord {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  org          Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         EssentialRecordKind
  title        String
  recordDate   DateTime?
  participants String? // quem participou da escuta / contexto da observação
  notes        String?
  points       String? // pontos de atenção identificados
  createdAt    DateTime            @default(now())

  @@index([tenantId])
  @@map("essential_records")
}

// =====================================================================
// REGISTRO DE DECISÃO — modelos (Anexo Técnico ICD do Líder v1, §5).
//
// Coexiste com Assessment/Response/IcdScore (modelo legado 4 Rs) durante
// a transição. Os scores ICD por decisão e o cálculo trimestral entram
// nas próximas migrations (tasks #46 e #47).
// =====================================================================

// §5.1 — Categorias de decisão. Lista padrão sugerida pelo Anexo:
// Pessoas, Operação, Cliente, Estratégia, Financeiro, Cultura, Processo,
// Risco/Compliance, Outro. Customizável por empresa via Super Admin.
model DecisionCategory {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String // identificador estável (ex.: "pessoas", "operacao")
  isDefault Boolean      @default(false) // seedada como sugestão CRIVO
  active    Boolean      @default(true)
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  decisions Decision[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("decision_categories")
}

// §5.1 — Públicos / áreas impactados pela decisão. Multi-seleção por decisão.
// Cadastrados por empresa no Super Admin (áreas, unidades, cargos, públicos).
model AffectedAudience {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  active    Boolean      @default(true)
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  decisions DecisionAudience[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("affected_audiences")
}

// §5.1 — Decisão real registrada pela liderança. Base operacional do ICD
// e do histórico de prática decisória. Os campos abaixo cobrem o registro
// visível ao líder; respostas P1-P8 e score por eixo vivem em modelos
// próprios (próxima migration — task #46).
model Decision {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  org      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaderId String       @db.Uuid
  leader   User         @relation("LeaderDecisions", fields: [leaderId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  categoryId     String?                 @db.Uuid
  category       DecisionCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  impact         DecisionImpact
  type           DecisionType
  pocketUse      DecisionPocketUse       @default(NAO_UTILIZADO)
  pressureFactor DecisionPressureFactor?
  revisionPeriod DecisionRevisionPeriod  @default(SEM_REVISAO)
  status         DecisionStatus          @default(EM_REGISTRO)

  // Momento em que a decisão foi tomada (não o registro). Anexo §5.1.
  decidedAt DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft-delete (#77): líderes podem "remover" decisões EM_REGISTRO/REGISTRADA,
  // mas o registro fica para auditoria (§17). NULL = ativo; timestamp = removido.
  deletedAt DateTime?

  audiences          DecisionAudience[]
  sustentationAction SustentationAction?
  icdScore           DecisionIcdScore?
  pocketSessions     PocketSession[] // vínculo opcional (§8)

  @@index([tenantId])
  @@index([leaderId])
  @@index([decidedAt])
  @@index([deletedAt])
  @@map("decisions")
}

// §5.1 — M:N entre Decision e AffectedAudience. Permite que uma decisão
// afete múltiplos públicos simultaneamente (RH, Comercial, Operações...).
model DecisionAudience {
  decisionId String           @db.Uuid
  decision   Decision         @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  audienceId String           @db.Uuid
  audience   AffectedAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@id([decisionId, audienceId])
  @@index([audienceId])
  @@map("decision_audiences")
}

// §5.2 — Ação concreta para sustentar/implementar/comunicar a decisão.
// 1:1 obrigatória com a decisão. Reusa ActionStatus existente.
model SustentationAction {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  org        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisionId String       @unique @db.Uuid
  decision   Decision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  action         String // O que será feito (obrigatório, §5.2)
  responsible    String // Pessoa, líder, área ou equipe (obrigatório)
  deadline       DateTime // Prazo limite ou data da 1ª revisão (obrigatório)
  expectedResult String? // Qual efeito a ação pretende gerar (opcional)
  evidenceUrl    String? // Ata, comunicado, plano, print, indicador… (opcional)
  status         ActionStatus @default(SUGERIDA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([decisionId])
  @@map("sustentation_actions")
}

// Anexo ICD §6–§9 — ICD de UMA decisão (4 eixos × 2 perguntas). 1:1 com Decision.
// `axes` é um Json {clareza, criterio, alinhamento, sustentacao} cada um 0–100
// (média dos 2 scores das perguntas do eixo). `score` é a média dos 4 eixos.
// `answers` armazena as 8 respostas brutas (id P1-P8 + value 1-5) para auditoria.
// `weight` espelha DECISION_IMPACT_WEIGHT do impact da decisão na hora do registro
// (BAIXO=0 → não entra no fechamento trimestral; MEDIO=1; ALTO=2).
model DecisionIcdScore {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  org        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisionId String       @unique @db.Uuid
  decision   Decision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  leaderId   String       @db.Uuid
  leader     User         @relation("LeaderDecisionIcdScores", fields: [leaderId], references: [id], onDelete: Cascade)
  // Ciclo trimestral em que a avaliação caiu (definido pelo decidedAt da decisão).
  // null = avaliada fora de qualquer ciclo aberto (legado/seed). §9.4 conta só
  // as que têm cycleId no fechamento.
  cycleId    String?      @db.Uuid
  cycle      IcdCycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  score      Int // 0–100, média dos 4 eixos (§9.2)
  axes       Json // { clareza, criterio, alinhamento, sustentacao } cada 0–100
  answers    Json // [{ id: "P1"|...|"P8", value: 1..5 }]
  weight     Int // 0|1|2 derivado do impact da decisão (§9.3)
  computedAt DateTime @default(now())

  @@index([tenantId])
  @@index([leaderId])
  @@index([cycleId])
  @@index([computedAt])
  @@map("decision_icd_scores")
}

// Anexo ICD §9.4 e §9.6 — janela trimestral oficial do ICD. Um ciclo agrupa
// todas as avaliações de decisões cuja `decidedAt` cai dentro do intervalo
// [startsAt, endsAt]. OPEN = parcial; CLOSED = oficial congelado. Único por
// tenant: só pode existir 1 OPEN por vez (lógica garantida no service).
model IcdCycle {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  org       Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // ex: "2026-Q3" (label gerado, editável)
  quarter   Int // 1..4
  year      Int
  startsAt  DateTime
  endsAt    DateTime
  status    IcdCycleStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  scores        DecisionIcdScore[]
  leaderResults LeaderQuarterlyIcd[]
  companyResult CompanyQuarterlyIcd?

  @@unique([tenantId, year, quarter])
  @@index([tenantId])
  @@index([status])
  @@map("icd_cycles")
}

// Anexo ICD §9.4 — ICD trimestral ponderado de um líder. Gerado no fechamento
// do ciclo. Inclui só decisões MÉDIO/ALTO impacto avaliadas pelo ICD dentro do
// ciclo (peso > 0). Líderes com 0 decisões elegíveis NÃO geram registro
// (ficam fora do §9.5 média da empresa).
model LeaderQuarterlyIcd {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  org      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId  String       @db.Uuid
  cycle    IcdCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  leaderId String       @db.Uuid
  leader   User         @relation("LeaderQuarterlyIcdScores", fields: [leaderId], references: [id], onDelete: Cascade)

  score         Int // 0–100, média ponderada das decisões elegíveis
  decisionCount Int // quantas decisões MÉDIO/ALTO elegíveis entraram
  totalWeight   Int // soma dos pesos (peso médio + peso alto)
  axesAverage   Json // { clareza, criterio, alinhamento, sustentacao } médias ponderadas
  computedAt    DateTime @default(now())

  @@unique([cycleId, leaderId]) // um resultado por líder por ciclo
  @@index([tenantId])
  @@index([leaderId])
  @@map("leader_quarterly_icd")
}

// Anexo ICD §9.5 — ICD oficial da empresa no ciclo. Média dos ICDs trimestrais
// dos líderes elegíveis (>= 1 decisão MÉDIO/ALTO avaliada). NÃO é média direta
// das decisões. §11: só calculado se >= 5 líderes elegíveis (regra de
// supressão); abaixo disso, score fica null e `suppressed=true`.
model CompanyQuarterlyIcd {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  org      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId  String       @unique @db.Uuid // 1:1 com ciclo
  cycle    IcdCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  score           Int? // null se suppressed (< 5 líderes elegíveis)
  eligibleLeaders Int // quantos líderes elegíveis no ciclo
  suppressed      Boolean  @default(false) // §11: recorte < 5
  distribution    Json // { critica, desenvolvimento, funcional, consistente, avancada, elevada } counts
  axesAverage     Json // médias agregadas dos 4 eixos (apenas se !suppressed)
  computedAt      DateTime @default(now())

  @@index([tenantId])
  @@map("company_quarterly_icd")
}

// Anexo Pocket §5/§12 — sessão do Pocket CRIVO. Iniciada quando o líder abre
// o módulo no app. Contém metadados de uso (contexto opcional, momento) e
// pode ser vinculada a uma Decisão existente (§8). Histórico individual (§13).
model PocketSession {
  id       String       @id @default(uuid()) @db.Uuid
  tenantId String       @db.Uuid
  org      Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaderId String       @db.Uuid
  leader   User         @relation("LeaderPocketSessions", fields: [leaderId], references: [id], onDelete: Cascade)

  context          String? // texto curto opcional (§7) — não é obrigatório
  momentOfUse      PocketMomentOfUse   @default(AVULSO)
  decisionId       String?             @db.Uuid // vínculo opcional §8
  decision         Decision?           @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  status           PocketSessionStatus @default(EM_ANDAMENTO)
  questionsVersion String              @default("v1") // versão das perguntas (§12)
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  reflections PocketReflection[]
  aiSummary   PocketAiSummary?

  @@index([tenantId])
  @@index([leaderId])
  @@index([decisionId])
  @@map("pocket_sessions")
}

// Anexo Pocket §7/§12 — reflexão a uma das 10 perguntas oficiais (C1-O2).
// Resposta é opcional (texto livre curto) e tags são opcionais. Cada pergunta
// pode aparecer no máximo 1 vez por sessão (gerenciado no service).
model PocketReflection {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  org          Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId    String        @db.Uuid
  session      PocketSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionCode String // "C1" .. "O2"
  text         String? // resposta reflexiva opcional
  tags         String[] // tags opcionais (sinalização de estado, §7)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([sessionId, questionCode]) // 1 reflexão por pergunta por sessão
  @@index([tenantId])
  @@map("pocket_reflections")
}

// Anexo Pocket §7/§10 — síntese gerada pela Mentoria IA quando ativada.
// 1:1 com a sessão. Inclui versão do modelo/prompt para auditoria (§12).
model PocketAiSummary {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  org            Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId      String        @unique @db.Uuid
  session        PocketSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  synthesis      String // resumo da reflexão do líder
  recommendation String? // cuidado/atenção sugerida (Anexo §10)
  nextStep       String? // próximo passo sugerido (Anexo §10)
  modelVersion   String // ex: "claude-opus-4-7-2026-06"
  createdAt      DateTime      @default(now())

  @@index([tenantId])
  @@map("pocket_ai_summaries")
}

// ───────────────────────────────────────────────────────────────────────────
// Motor de Decisão CNAE/NR-1 (control plane / global).
// Classificação PRELIMINAR técnica por divisão CNAE → método de diagnóstico
// (Essencial/Organizacional) + saídas técnicas. Editável por especialista.
// ───────────────────────────────────────────────────────────────────────────

enum CnaeRiskLevel {
  BAIXO
  BAIXO_MEDIO
  MEDIO
  MEDIO_ALTO
  ALTO
}

/// Regra por divisão CNAE (2 dígitos). 87 divisões da CNAE 2.0. Global, sem RLS.
model CnaeDivisionRule {
  id                     String           @id @default(uuid()) @db.Uuid
  divisionCode           String           @unique @map("division_code") // "01".."99" (string, 2 dígitos)
  officialName           String           @map("official_name")
  cnaeSection            String?          @map("cnae_section") // seção macro (A..U), quando disponível
  preliminaryRiskLevel   CnaeRiskLevel    @map("preliminary_risk_level")
  defaultMethod          DiagnosticMethod @map("default_method") // ESSENCIAL | ORGANIZACIONAL
  defaultTechnicalOutput String           @map("default_technical_output")

  pgrRequired             Boolean @default(false) @map("pgr_required")
  riskInventoryRequired   Boolean @default(false) @map("risk_inventory_required")
  aepRequired             Boolean @default(false) @map("aep_required")
  evidenceRequired        Boolean @default(false) @map("evidence_required")
  executiveReportRequired Boolean @default(false) @map("executive_report_required")
  actionPlanRequired      Boolean @default(false) @map("action_plan_required")

  organizationalTriggerRules Json?   @map("organizational_trigger_rules") // gatilhos que elevam p/ Organizacional
  technicalObservation       String? @map("technical_observation")
  isActive                   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cnae_division_rules")
}

/// Histórico/auditoria de cada execução do motor (cópia imutável da decisão).
model CnaeDecisionHistory {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String?   @map("company_id") @db.Uuid // lead/tenant, se houver
  cnpj                 String?
  cnaeCode             String?   @map("cnae_code")
  divisionCode         String?   @map("division_code")
  inputData            Json      @map("input_data_json")
  divisionRule         Json?     @map("division_rule_json")
  decisionResult       Json      @map("decision_result_json")
  recommendedMethod    String?   @map("recommended_method")
  riskLevel            String?   @map("risk_level")
  manualReviewRequired Boolean   @default(false) @map("manual_review_required")
  reviewedBy           String?   @map("reviewed_by")
  reviewedAt           DateTime? @map("reviewed_at")
  reviewNotes          String?   @map("review_notes")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([cnpj])
  @@index([divisionCode])
  @@index([createdAt])
  @@map("cnae_decision_history")
}

// ───────────────────────────────────────────────────────────────────────────
// Integrações externas (assinatura/cobrança) + modelos de contrato.
// ───────────────────────────────────────────────────────────────────────────

/// Conta de e-mail que DISPARA as mensagens da CRIVO (Governança · E-mail de
/// envio): a senha de acesso do cliente, o Relatório Preliminar com o e-book em
/// anexo e o convite de campanha do ICD — todos saem pelo mesmo transporte.
///
/// LINHA ÚNICA. Sobrepõe as variáveis SMTP_* do ambiente quando `enabled` é
/// verdadeiro; desligada ou ausente, o envio segue EXATAMENTE pelo que está no
/// ambiente, como antes desta tabela existir.
///
/// A senha fica CIFRADA em repouso (AES-256-GCM, secret-crypto) e nunca é
/// devolvida pela API — só `passwordHint`, com os 4 últimos caracteres.
model MailSettings {
  id        String  @id @default(uuid()) @db.Uuid
  enabled   Boolean @default(false)
  host      String
  port      Int     @default(465)
  secure    Boolean @default(true)
  username  String  @map("smtp_user") // usuário autenticado no SMTP
  fromName  String? @map("from_name") // nome exibido do remetente
  fromEmail String  @map("from_email") // endereço do remetente

  passwordEnc  String @map("password_enc") // ciphertext base64
  passwordIv   String @map("password_iv") // IV base64
  passwordTag  String @map("password_tag") // auth tag base64 (GCM)
  passwordHint String @map("password_hint") // 4 últimos caracteres, para conferência

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mail_settings")
}

/// Credenciais de uma integração externa (cifradas). 1 linha por provedor.
model PlatformIntegration {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String   @unique // 'clicksign' | 'asaas' | 'mercadopago'
  enabled        Boolean  @default(false)
  credentialEnc  String?  @map("credential_enc") // chave/token cifrado (secret-crypto)
  credentialIv   String?  @map("credential_iv")
  credentialTag  String?  @map("credential_tag")
  credentialHint String?  @map("credential_hint")
  sandbox        Boolean  @default(false) // ambiente de teste (Asaas/MercadoPago)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("platform_integrations")
}

/// Modelo de contrato (PDF/DOCX) carregado pelo admin, guardado em base64.
model ContractTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  data      String   @db.Text // base64 do arquivo
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contract_templates")
}

/// E-book complementar disparado ao lead por E-MAIL (anexo) e WHATSAPP (link),
/// importado pelo super admin em Governança · E-book. Guardado em base64, do
/// mesmo jeito que o ContractTemplate.
///
/// LINHA ÚNICA por design: importar de novo SUBSTITUI o arquivo atual. Não é um
/// acervo — o disparo precisa de UM e-book corrente, sem ambiguidade sobre qual
/// sai. Enquanto a tabela estiver vazia, o sistema continua usando o PDF
/// estático da LP (EBOOK_URL), exatamente como antes desta tabela existir.
model EbookAsset {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes") // tamanho do arquivo original (bytes)
  data      String   @db.Text // base64 do arquivo
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ebook_assets")
}

// ───────────────────────────────────────────────────────────────────────────
// Metodologia configurável (Fase 1): dimensões, perguntas, pesos e faixas dos
// instrumentos de diagnóstico ficam em DADOS (editáveis no Super Admin, sem
// depender do desenvolvedor) e versionados. O motor lê a versão ATIVA.
// ───────────────────────────────────────────────────────────────────────────

// LEGADO — mantido no banco até a fatia de limpeza (a coluna virou TEXT).
enum MethodologyInstrument {
  PRE_DIAGNOSTIC // Diagnóstico Executivo
  PSYCHOSOCIAL // Diagnóstico Organizacional (psicossocial)
}

// Modo de agregação do score (call 14/07): estrutura da fórmula por instrumento.
enum ScoreAggregation {
  MEDIA_PONDERADA // média ponderada por pesos de pergunta e dimensão (padrão)
  MEDIA_SIMPLES // pesos ignorados
  SOMA_NORMALIZADA // % do máximo possível sobre todas as questões
}

/// Catálogo de instrumentos de diagnóstico (motor dinâmico — call 14/07).
/// Os 2 built-in usam como slug os valores HISTÓRICOS do enum
/// ('PRE_DIAGNOSTIC'/'PSYCHOSOCIAL') — zero rewrite de dados na migração e os
/// consumidores hardcoded (LP, /q/slug, ciclos ICD) ficam intocados.
model DiagnosticInstrument {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique // novos: kebab-case (ex.: clima-organizacional)
  name        String
  bandKind    MethodologyBandKind @default(MATURITY) @map("band_kind")
  aggregation ScoreAggregation    @default(MEDIA_PONDERADA)
  description String?             @db.Text
  active      Boolean             @default(true)
  builtIn     Boolean             @default(false) @map("built_in") // imutável/indelével
  /// Método CRIVO que este instrumento atende (INICIAL | ESSENCIAL |
  /// ORGANIZACIONAL). É o que liga o diagnóstico contratado ao questionário
  /// aplicado — antes era hardcoded. null = instrumento avulso do catálogo,
  /// aplicado por link. Só um instrumento ATIVO por método é usado.
  method      String?

  versions        MethodologyVersion[]
  links           DiagnosticLink[]
  responses       DiagnosticResponse[]
  reportTemplates ReportTemplate[]
  sourcePlans     ActionPlan[]         @relation("plan_source_instrument")
  sourceItems     ActionItem[]         @relation("item_source_instrument")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("diagnostic_instruments")
}

/// Link público de aplicação de um diagnóstico do catálogo por empresa
/// (motor dinâmico — call 14/07). Rota /d/<slug>, anônima, análoga ao /q/<slug>.
model DiagnosticLink {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  org            Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instrumentSlug String               @map("instrument_slug")
  instrument     DiagnosticInstrument @relation(fields: [instrumentSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  slug           String               @unique // /d/<slug> — 64 bits de entropia
  label          String?
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")

  @@unique([tenantId, instrumentSlug])
  @@index([tenantId])
  @@map("diagnostic_links")
}

/// Resposta ANÔNIMA de um diagnóstico do catálogo (espelho do psicossocial):
/// sem userId, agregação com supressão <5, RLS por tenant, pin da metodologia.
model DiagnosticResponse {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  org                  Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instrumentSlug       String               @map("instrument_slug")
  instrument           DiagnosticInstrument @relation(fields: [instrumentSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  sector               String?
  /// Retrato dos recortes do colaborador no envio (ver PsychosocialResponse.cohort).
  cohort               Json?
  /// Como a resposta chegou. null/ausente = link público (/d/<slug>, /r/<token>).
  /// 'SELF_ASSESSMENT' = autoavaliação do gestor no painel — existe UMA por
  /// empresa (refazer substitui), para o agregado não inflar a cada revisão.
  origin               String?
  answers              Json // [{ questionId, value }] escala 1–5
  score                Float // 0–100 (Float: o motor v3.1 pontua com 1 casa decimal)
  level                String // código da faixa da metodologia
  byDimension          Json // { slug: 0–100 }
  methodologyVersionId String?              @db.Uuid // pin MET1
  /// Campanha (ciclo) em que esta resposta foi coletada — mesmo papel do campo
  /// homonimo em psychosocial_responses. null = coleta avulsa.
  cycleId              String?              @map("cycle_id") @db.Uuid
  submittedAt          DateTime             @default(now())

  @@index([tenantId])
  @@index([instrumentSlug])
  @@index([methodologyVersionId])
  @@map("diagnostic_responses")
}

/// Funcionário cadastrado pelo cliente para responder o diagnóstico contratado.
/// Cada colaborador tem um TOKEN de link único (/r/<token>); no acesso valida o
/// CPF cadastrado e, ao concluir, grava `respondedAt` — a resposta em si continua
/// ANÔNIMA (psychosocial_responses/diagnostic_responses) e NÃO referencia esta
/// linha, preservando a agregação com supressão (NR-1/LGPD).
model Collaborator {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  org              Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  phone            String? // WhatsApp (dígitos; envio via API VAI)
  sector           String?
  email            String?
  cpf              String // normalizado (11 dígitos) — valida o acesso ao link
  // Recortes (Ajustes Finais de Homologação — Colaboradores/CSV). Todos
  // opcionais. GHE é informado pela empresa, NUNCA inferido de setor/área.
  // "Processo" não entra no cadastro-base (é dado do fator/ação).
  unit             String?
  area             String?
  role             String? // cargo/função
  shift            String? // turno (Manhã · Tarde · Noite · Rotativo · Administrativo)
  ghe              String? // grupo (homogêneo) de exposição, como a empresa cadastrou
  manager          String? // gestor
  workModel        String?      @map("work_model") // Presencial · Híbrido · Remoto
  gender           String?
  birthYear        Int?         @map("birth_year")
  ageBand          String?      @map("age_band")
  token            String       @unique // /r/<token> — 128 bits de entropia
  inviteEmailAt    DateTime?    @map("invite_email_at")
  inviteWhatsappAt DateTime?    @map("invite_whatsapp_at")
  respondedAt      DateTime?    @map("responded_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  invites CampaignInvite[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@map("collaborators")
}

/// Convite de um colaborador para UMA campanha (ciclo). O envio ao colaborador
/// passa a acontecer sempre dentro de uma campanha — antes o e-mail saia apenas
/// por existir cadastro importado, e a resposta nao pertencia a ciclo nenhum,
/// entao "baseline e evolucao por ciclo" era impossivel de medir.
/// O token do LINK vive aqui: o mesmo colaborador pode ser convidado de novo em
/// outra campanha (novo convite, novo token) sem perder o historico do anterior.
model CampaignInvite {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  org            Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleId        String          @map("cycle_id") @db.Uuid
  cycle          AssessmentCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  collaboratorId String          @map("collaborator_id") @db.Uuid
  collaborator   Collaborator    @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  token          String          @unique // /r/<token> — 128 bits de entropia
  sentEmailAt    DateTime?       @map("sent_email_at")
  sentWhatsappAt DateTime?       @map("sent_whatsapp_at")
  respondedAt    DateTime?       @map("responded_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([cycleId, collaboratorId])
  @@index([tenantId])
  @@index([cycleId])
  @@map("campaign_invites")
}

/// Recuperação de senha do portal (auto-atendimento). O usuário pede pelo
/// e-mail, recebe um link de USO ÚNICO e com validade curta, e define a senha
/// nova ele mesmo. Guardamos só o HASH do token: quem lê o banco (ou um dump)
/// não consegue redefinir a senha de ninguém.
///
/// O e-mail NÃO é único na plataforma (@@unique([tenantId, email])), então a
/// mesma pessoa pode ter conta em mais de uma empresa — por isso o token é por
/// USUÁRIO, e o e-mail de recuperação lista uma opção por empresa.
model PasswordResetToken {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique @map("token_hash") // sha256 do token entregue
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at") // uso único: preenchido, não vale mais
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

enum MethodologyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MethodologyBandKind {
  MATURITY // maturidade (maior = melhor)
  RISK // risco (proteção; maior = menor risco)
}

/// Uma versão de metodologia de um instrumento. Só UMA fica ACTIVE por instrumento.
model MethodologyVersion {
  id                        String               @id @default(uuid()) @db.Uuid
  instrument                String // slug do DiagnosticInstrument (era enum; TEXT desde a migração do catálogo)
  instrumentRef             DiagnosticInstrument @relation(fields: [instrument], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  version                   Int
  label                     String
  status                    MethodologyStatus    @default(DRAFT)
  notes                     String?              @db.Text
  // Escala de resposta (aba "Escalas e regras" do mockup): rótulos dos 5 pontos
  // Likert, editáveis por versão. Vazio = padrão CRIVO. NÃO muda a pontuação
  // (segue normalizando 1–5 → 0–100); só o texto que o respondente vê.
  scaleLabels               String[]             @default([]) @map("scale_labels")
  // Motor v3.1 (Anexo D/E): casas decimais do resultado (`rounding`; 1 reproduz
  // 62,4 e 47,3 da homologação) e cobertura mínima de respostas válidas (%) para
  // liberar o RESULTADO OFICIAL (`minimum_valid_completion_percent`, típico 70).
  rounding                  Int?                 @map("rounding")
  minValidCompletionPercent Int?                 @map("min_valid_completion_percent")
  createdBy                 String?              @map("created_by")
  createdAt                 DateTime             @default(now()) @map("created_at")
  publishedAt               DateTime?            @map("published_at")

  factors    MethodologyFactor[]
  dimensions MethodologyDimension[]
  questions  MethodologyQuestion[]
  bands      MethodologyBand[]

  @@unique([instrument, version])
  @@index([instrument, status])
  @@map("methodology_versions")
}

model MethodologyDimension {
  id          String             @id @default(uuid()) @db.Uuid
  versionId   String             @map("version_id") @db.Uuid
  version     MethodologyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  slug        String
  label       String
  weight      Float              @default(1)
  order       Int                @default(0)
  // Árvore Dimensão → Subdimensão (mockup do cliente 15/07). parentSlug null =
  // dimensão de topo; preenchido = subdimensão daquele pai. As perguntas se
  // ligam às FOLHAS (dimensão/subdimensão sem filhos).
  parentSlug  String?            @map("parent_slug")
  // Regra de cálculo do nó (só folhas e nós internos de MÉDIA). null = herda o
  // modo do instrumento. Espelha "média simples/ponderada" por subdimensão.
  aggregation ScoreAggregation?
  // SEVERIDADE (1–5) da Matriz de Risco psicossocial: gravidade da consequência
  // caso o fator se mantenha em nível crítico. É parâmetro da ESCALA (dimensão de
  // topo) e, por definição do método, adaptável à realidade laboral da empresa.
  // null = escala sem severidade parametrizada → fica FORA da matriz (não entra
  // com 0, que viraria um risco "aceitável" falso). Não afeta média nem pontuação.
  severity    Int?

  @@unique([versionId, slug])
  @@index([versionId, parentSlug])
  @@map("methodology_dimensions")
}

/// Fator de risco psicossocial da metodologia (Orientacao NR-1 §8): a SEVERIDADE
/// pertence ao FATOR e as suas possiveis consequencias — nao a dimensao. Cada
/// fator vincula-se (opcionalmente) a uma dimensao, de onde sai a PROBABILIDADE
/// pelas respostas; Risco = P x S na Matriz de Risco. Versionado junto com o
/// resto da metodologia: publicar cria versao nova, o historico fica intacto.
model MethodologyFactor {
  id            String             @id @default(uuid()) @db.Uuid
  versionId     String             @map("version_id") @db.Uuid
  version       MethodologyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  slug          String
  label         String
  /// Codigo estavel da biblioteca de riscos (Orientacao Funcional 5.1).
  /// Ex.: RPS-001. Vira o ID do fator no Dossie quando preenchido.
  code          String?
  /// Descricao curta e objetiva do risco/fator (5.1).
  definition    String?
  /// Fonte/circunstancia padrao: o contexto de trabalho que origina o risco (5.1).
  sourceContext String?            @map("source_context")
  /// ATIVO | INATIVO | ARQUIVADO (5.1). Só ATIVO entra na matriz.
  status        String             @default("ATIVO")
  /// Versao metodologica do proprio fator, para auditoria (5.1). O campo
  /// `version` acima ja e a relacao com MethodologyVersion, por isso o nome.
  factorVersion String?            @map("factor_version")
  /// S-base (1-5): magnitude da consequencia possivel do fator.
  severity      Int
  /// Possiveis agravos/consequencias documentados — justificam a severidade e
  /// alimentam a coluna "Possiveis agravos" do Inventario Tecnico do Dossie.
  consequences  String?
  /// Dimensao da metodologia que fornece a evidencia de exposicao (probabilidade).
  /// Referencia textual (mesmo padrao de MethodologyQuestion.dimensionSlug).
  dimensionSlug String?            @map("dimension_slug")
  order         Int                @default(0)

  @@unique([versionId, slug])
  @@index([versionId])
  @@map("methodology_factors")
}

model MethodologyQuestion {
  id                 String             @id @default(uuid()) @db.Uuid
  versionId          String             @map("version_id") @db.Uuid
  version            MethodologyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  dimensionSlug      String             @map("dimension_slug")
  /// Fatores de risco que ESTA pergunta alimenta (NR-1 §9: "a pergunta alimenta
  /// um ou mais fatores"). Slugs de MethodologyFactor da mesma versão; vazio =
  /// a pergunta não entra em nenhuma matriz de risco. A DIMENSÃO segue mandando
  /// na pontuação (0-100) — este vínculo é só a leitura de RISCO.
  factorSlugs        String[]           @default([]) @map("factor_slugs")
  text               String             @db.Text
  weight             Float              @default(1)
  inverse            Boolean            @default(false) // true = afirmação negativa (inverte na pontuação)
  required           Boolean            @default(true) // obrigatória (mockup): opcional não trava o respondente
  // Item de CONTEXTO (Anexo D/E `scored:false`): coletado, fora do cálculo.
  scored             Boolean            @default(true)
  // Exibição condicional (`show_when`): item só é aplicável quando a resposta da
  // pergunta `showWhenQuestionId` satisfaz `operador valor`. Não aplicável = fora
  // do cálculo E do denominador de cobertura.
  showWhenQuestionId Int?               @map("show_when_question_id")
  showWhenOperator   String?            @map("show_when_operator")
  showWhenValue      Int?               @map("show_when_value")
  order              Int                @default(0)

  @@index([versionId])
  @@map("methodology_questions")
}

model MethodologyBand {
  id        String              @id @default(uuid()) @db.Uuid
  versionId String              @map("version_id") @db.Uuid
  version   MethodologyVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind      MethodologyBandKind
  code      String
  label     String
  // Motor v3.1: limites DECIMAIS (illustrative_bands 0–24.9 / 25–49.9 / 50–74.9).
  min       Float
  max       Float
  color     String?
  order     Int                 @default(0)

  @@index([versionId])
  @@map("methodology_bands")
}

/// Custos Invisíveis (Fase 2) — estimativa do custo oculto por empresa (1 por tenant).
/// Protegido por RLS (tenantId = current_tenant()). itens/cenários em JSON.
model InvisibleCostEstimate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  items      Json // InvisibleCostItem[]
  scenarios  Json // { conservador, moderado, otimista }
  confidence String   @default("MEDIA") // ALTA | MEDIA | BAIXA
  notes      String?  @db.Text
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  @@unique([tenantId])
  @@map("invisible_cost_estimates")
}

/// Snapshot da estimativa de custos invisíveis ("Congelar como ciclo") — aba
/// Histórico do Radar. InvisibleCostEstimate é 1 por tenant e não guarda
/// histórico; cada snapshot congela itens + cenários + totais calculados por
/// computeInvisibleCosts naquele momento. Data plane (RLS por tenant).
model InvisibleCostSnapshot {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  org             Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String // rótulo do ciclo/período (ex.: "2026.1")
  items           Json // InvisibleCostItem[] congelados
  scenarios       Json // { conservador, moderado, otimista } vigentes
  confidence      String       @default("MEDIA")
  totals          Json // { base, conservador, moderado, otimista }
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdByName   String?      @map("created_by_name")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("invisible_cost_snapshots")
}

/// People Analytics (Fase 4) — indicadores de RH por período + última análise da IA.
/// 1 por empresa, protegido por RLS (tenantId = current_tenant()).
model PeopleAnalyticsData {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  periods    Json // PeoplePeriod[] (cada período pode ter headcountByArea opcional)
  // Catálogo de indicadores: metadados de governança por indicador fixo +
  // indicadores customizados (PeopleCatalogEntry[]). Só metadados — nunca
  // altera computePeopleTrends nem scores metodológicos.
  catalog    Json?
  analysis   Json? // { summary, alerts[], hypotheses[], recommendations[] }
  analysisAt DateTime?
  updatedBy  String?
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId])
  @@map("people_analytics_data")
}

// =====================================================================
// NOTIFICAÇÕES (push FCM + gates por gatilho) — control plane, owner-only.
// - NotificationSetting: 1 linha por gatilho (key). Guarda só o override de
//   ativação por canal; o rótulo/descrição PT-BR vivem no código (registry).
//   Ausência de linha = ativo por padrão (default true nas colunas).
// - PushToken: tokens FCM por usuário/dispositivo. Gravado/lido só via owner
//   (prisma.admin); a rota /me/push-tokens escopa por tenantId+userId da sessão.
// =====================================================================

model NotificationSetting {
  key          String   @id
  emailEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  updatedBy    String?
  updatedAt    DateTime @updatedAt

  @@map("notification_settings")
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String // ios | android | web
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("push_tokens")
}

// =====================================================================
// GOVERNANÇA DE IA (módulo 'govia' — Programas › Governança de IA). Serviço
// contratado pelo CLIENTE para governar as PRÓPRIAS IAs: inventário de casos
// de uso, risco inerente/residual (julgamento do cliente, não score CRIVO),
// decisão humana com justificativa obrigatória e trilha, vínculos com
// Evidências/Plano de Evolução, incidentes, políticas e agenda de revisão.
// Data plane (RLS por tenant) — separado de AiSettings/AiPrompt (control
// plane, que configuram o motor CRIVO). O Super Admin (Módulos › Governança
// de IA) lê estas mesmas tabelas com tenantId explícito; não escreve.
// =====================================================================

enum AiRiskLevel {
  ALTO
  MEDIO
  BAIXO
}

enum AiUseCaseStatus {
  RASCUNHO
  EM_AVALIACAO
  APROVADO
  CONDICIONADO
  RESTRITO
  REJEITADO
}

enum AiDecision {
  APROVAR
  CONDICIONAR
  RESTRINGIR
  REJEITAR
}

enum AiLinkKind {
  EVIDENCE
  ACTION_ITEM
  WORKFORCE
}

enum AiIncidentSeverity {
  ALTA
  MEDIA
  BAIXA
}

enum AiIncidentStatus {
  ABERTO
  ENCERRADO
}

enum AiPolicyStatus {
  RASCUNHO
  EM_REVISAO
  APROVADO
}

/// Caso de uso de IA do cliente. `code` é "IA-NN" sequencial POR EMPRESA
/// (gerado no service dentro da transação do tenant; único por tenant).
model AiUseCase {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  org           Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String // IA-01, IA-02… (sequencial por tenant)
  name          String
  purpose       String // finalidade
  area          String
  ownerName     String          @map("owner_name") // responsável (texto — pode não ser usuário do portal)
  ownerUserId   String?         @map("owner_user_id") @db.Uuid // opcional: usuário do portal responsável
  technology    String
  vendor        String?
  dataUsed      String          @map("data_used") // dados utilizados
  audience      String // público afetado
  inherentRisk  AiRiskLevel     @map("inherent_risk")
  residualRisk  AiRiskLevel     @map("residual_risk")
  controls      String[]        @default([]) // controles principais (lista curta)
  status        AiUseCaseStatus @default(RASCUNHO)
  justification String? // justificativa vigente (espelha a última decisão)
  nextReviewAt  DateTime?       @map("next_review_at")
  createdBy     String          @map("created_by") // nome/e-mail de quem cadastrou
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  decisions AiUseCaseDecision[]
  links     AiUseCaseLink[]
  incidents AiIncident[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ai_use_cases")
}

/// Trilha da decisão humana (uma linha por decisão; nunca editada). O status
/// do caso reflete a ÚLTIMA decisão; a história fica aqui + AuditLog.
model AiUseCaseDecision {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  org             Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  useCaseId       String       @map("use_case_id") @db.Uuid
  useCase         AiUseCase    @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  decision        AiDecision
  justification   String // obrigatória
  decidedByUserId String       @map("decided_by_user_id") @db.Uuid
  decidedByName   String       @map("decided_by_name")
  decidedAt       DateTime     @default(now()) @map("decided_at")

  @@index([tenantId])
  @@index([useCaseId])
  @@map("ai_use_case_decisions")
}

/// Vínculo navegável do caso com Evidência (Evidence.id), ação do Plano de
/// Evolução (ActionItem.id) ou, quando o módulo existir, tarefa Workforce.
/// Sem FK: o alvo pode ser apagado sem quebrar o caso (o service resolve o
/// título e devolve null quando não existe mais).
model AiUseCaseLink {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  useCaseId String       @map("use_case_id") @db.Uuid
  useCase   AiUseCase    @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  kind      AiLinkKind
  targetId  String       @map("target_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([useCaseId, kind, targetId])
  @@index([tenantId])
  @@map("ai_use_case_links")
}

/// Incidente de IA (opcionalmente ligado a um caso de uso).
model AiIncident {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  org         Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  useCaseId   String?            @map("use_case_id") @db.Uuid
  useCase     AiUseCase?         @relation(fields: [useCaseId], references: [id], onDelete: SetNull)
  severity    AiIncidentSeverity
  occurredAt  DateTime           @map("occurred_at")
  description String
  status      AiIncidentStatus   @default(ABERTO)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([useCaseId])
  @@map("ai_incidents")
}

/// Política/documento de governança de IA do cliente (versão + status + data).
/// O arquivo, quando houver, é um link (url) — pode apontar para uma
/// Evidência do portal ou para o repositório do cliente.
model AiPolicy {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  org         Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  version     String
  status      AiPolicyStatus @default(RASCUNHO)
  publishedAt DateTime?      @map("published_at")
  url         String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ai_policies")
}

// =====================================================================
// WORKFORCE INTELLIGENCE (módulo 'workforce' — Programas › Workforce
// Intelligence). Como o trabalho está organizado (processos, funções, tarefas,
// skills) e como pode ser redesenhado entre pessoas, processos e IA. Os
// percentuais (potencial IA, essencialidade humana, prontidão) são JULGAMENTOS
// de quem mapeou — nunca score CRIVO nem cálculo de IA. Fluxo da tarefa:
// cadastro → EM_VALIDACAO_CRIVO → VALIDADO_CRIVO (Super Admin, com nota) →
// DECIDIDO (decisão humana do cliente no portal, com quem/quando). Data plane
// (RLS por tenant): o Super Admin escreve/lê os MESMOS models via forTenant
// com o organizationId resolvido de Tenant.id.
// =====================================================================

enum WorkCriticality {
  ALTA
  MEDIA
  BAIXA
}

enum WorkRisk {
  ALTO
  MEDIO
  BAIXO
}

/// Taxonomia fixa dos 7 cenários de redesenho (WORKFORCE_SCENARIOS em @crivo/types).
enum WorkScenario {
  MANTER_HUMANO
  REDESENHAR_PROCESSO
  CAPACITAR
  AUTOMATIZAR_PARTE
  COPILOTO
  AGENTE_SUPERVISIONADO
  NAO_RECOMENDAR_IA
}

/// Origem epistêmica (INSIGHT_ORIGINS em @crivo/types): Fato / Inferência / Hipótese / Recomendação.
enum InsightOrigin {
  FATO
  INFERENCIA
  HIPOTESE
  RECOMENDACAO
}

enum WorkTaskStage {
  RASCUNHO
  EM_VALIDACAO_CRIVO
  VALIDADO_CRIVO
  DECIDIDO
}

enum WorkDecision {
  ACEITAR
  CONDICIONAR
  DEVOLVER
  REJEITAR
}

enum WorkPilotKind {
  BLUEPRINT
  PILOTO
}

enum WorkConfidence {
  ALTA
  MEDIA
  BAIXA
}

enum WorkPilotStatus {
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  // Protótipo Lovable do Super Admin (aba Blueprints): um blueprint passa por
  // revisão e aprovação antes de virar piloto; um piloto pode ser suspenso.
  EM_REVISAO
  APROVADO
  SUSPENSO
}

/// Processo mapeado. `aiThresholdPct` é o limiar DA EMPRESA para "cobertura de
/// IA" (% de tarefas com aiPotential ≥ limiar) — 60 é só o default do campo.
model WorkProcess {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  org            Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  area           String
  unitId         String?      @map("unit_id") @db.Uuid // recorte opcional (Unit do Grupo Empresarial), sem FK
  aiThresholdPct Int          @default(60) @map("ai_threshold_pct")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tasks  WorkTask[]
  pilots WorkPilot[]

  @@index([tenantId])
  @@map("work_processes")
}

/// Tarefa do trabalho real. `code` é "T-NN" sequencial POR EMPRESA (gerado no
/// service). Validação CRIVO e decisão do cliente ficam na própria linha (a
/// história completa vai para o AuditLog: workforce.task.validate / .decision).
model WorkTask {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  org               Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processId         String          @map("process_id") @db.Uuid
  process           WorkProcess     @relation(fields: [processId], references: [id], onDelete: Cascade)
  code              String
  role              String // função
  area              String
  name              String // tarefa
  input             String // entrada
  output            String // saída
  volumePerMonth    Int             @map("volume_per_month")
  durationMin       Int             @map("duration_min")
  criticality       WorkCriticality
  aiPotential       Int             @map("ai_potential") // 0-100, julgamento informado
  humanEssentiality Int             @map("human_essentiality") // 0-100, julgamento informado
  risk              WorkRisk
  readiness         Int // prontidão 0-100, julgamento informado
  scenario          WorkScenario
  // Narrativas de transição por tarefa (protótipo Lovable, aba "Cenários Pessoa
  // × Processo × IA"): como o trabalho é feito HOJE, como fica com IA
  // ASSISTINDO e como fica REDESENHADO. Texto livre, opcional — complementam
  // `scenario` (categoria), não o substituem.
  scenarioCurrent    String?         @map("scenario_current")
  scenarioAssisted   String?         @map("scenario_assisted")
  scenarioRedesigned String?         @map("scenario_redesigned")
  origin            InsightOrigin
  stage             WorkTaskStage   @default(RASCUNHO)
  validationNote    String?         @map("validation_note")
  validatedAt       DateTime?       @map("validated_at")
  validatedByName   String?         @map("validated_by_name") // e-mail/nome do super admin (sem relation)
  decision          WorkDecision?
  decisionNote      String?         @map("decision_note")
  decidedByUserId   String?         @map("decided_by_user_id") @db.Uuid
  decidedByName     String?         @map("decided_by_name")
  decidedAt         DateTime?       @map("decided_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([processId])
  @@map("work_tasks")
}

/// Skill prioritária: nível atual × alvo (0-100), agregado da empresa.
model WorkSkill {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  org       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  current   Int
  target    Int
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("work_skills")
}

/// Blueprint ou piloto (entregas dentro do módulo, não códigos de módulo).
/// Resultado com confiança declarada — nunca "economia garantida".
model WorkPilot {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  org        Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processId  String?         @map("process_id") @db.Uuid
  process    WorkProcess?    @relation(fields: [processId], references: [id], onDelete: SetNull)
  kind       WorkPilotKind   @default(PILOTO)
  name       String
  baseline   String
  indicator  String
  result     String          @default("")
  confidence WorkConfidence
  status     WorkPilotStatus @default(EM_ANDAMENTO)
  // Atributos de decisão do blueprint (protótipo Lovable do Super Admin):
  // texto livre informado pela CRIVO, nunca valor garantido — nulos até então.
  effort         String? @map("effort")
  potentialValue String? @map("potential_value")
  partner        String? @map("partner")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([processId])
  @@map("work_pilots")
}

// =====================================================================
// CONTEXTO E DIRETRIZES (módulo 'contexto' — Programas › Contexto e
// Diretrizes). Workspace da IA Contextualizada do CLIENTE: diretrizes
// institucionais, documentos autorizados com ciclo de vida, terminologia e o
// vínculo por caso de uso da IA. Data plane (tenantId + RLS). Só o que está
// APROVADO entra no prompt (AiSettingsService.buildTenantDirectives lê com
// tenantId explícito) — rascunho, substituído e revogado nunca.
// =====================================================================

enum TenantDirectiveStatus {
  RASCUNHO
  EM_REVISAO
  APROVADA
  REVOGADA
}

enum TenantDocumentStatus {
  RASCUNHO
  EM_REVISAO
  APROVADO_PUBLICADO
  SUBSTITUIDO
  REVOGADO
}

/// Diretriz institucional (missão, valores, prioridades, compromissos…).
/// `version` sobe quando uma diretriz APROVADA é editada (volta a RASCUNHO).
model TenantDirective {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @db.Uuid
  org                Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  text               String                @db.Text
  status             TenantDirectiveStatus @default(RASCUNHO)
  version            Int                   @default(1)
  approvedByUserId   String?               @map("approved_by_user_id") @db.Uuid
  approvedByName     String?               @map("approved_by_name")
  approvedAt         DateTime?             @map("approved_at")
  revokeJustification String?              @map("revoke_justification")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_directives")
}

/// Documento autorizado. `code` é "D-NNN" sequencial POR EMPRESA. O binário
/// fica em TenantDocumentFile (1:1); aqui só metadados + texto extraído.
model TenantDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  org                 Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                String // D-001, D-002… (sequencial por tenant)
  title               String
  kind                String // Política | Manual | Diretriz… (texto livre)
  cnpj                String?
  unitId              String?              @map("unit_id") @db.Uuid
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  version             String               @default("v1.0")
  issuedAt            DateTime?            @map("issued_at")
  owner               String // responsável (texto)
  purpose             String // finalidade
  modules             String[]             @default([]) // códigos de MODULES autorizados
  accessLevel         String               @map("access_level")
  status              TenantDocumentStatus @default(RASCUNHO)
  replacedById        String?              @map("replaced_by_id") @db.Uuid // documento que o substituiu
  revokeJustification String?              @map("revoke_justification")
  url                 String? // referência externa (quando não há upload)
  fileName            String?              @map("file_name")
  fileMime            String?              @map("file_mime")
  fileSize            Int?                 @map("file_size")
  extractedText       String?              @map("extracted_text") @db.Text // texto que vai ao prompt
  extractedChars      Int                  @default(0) @map("extracted_chars") // tamanho do texto (listagem sem carregar o texto)
  approvedByUserId    String?              @map("approved_by_user_id") @db.Uuid
  approvedByName      String?              @map("approved_by_name")
  approvedAt          DateTime?            @map("approved_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  file TenantDocumentFile?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_documents")
}

/// Bytes do arquivo de um documento autorizado (padrão EvidenceFile): tabela
/// separada para os bytes nunca virem em listagem — só no download.
model TenantDocumentFile {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  org        Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId String         @unique @map("document_id") @db.Uuid
  document   TenantDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  data       Bytes
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_document_files")
}

/// Terminologia e regras de negócio do cliente (aba "Terminologia e Regras").
model TenantTerm {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  org        Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term       String
  definition String       @db.Text
  context    String // módulos/áreas onde vale (texto)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tenant_terms")
}

/// Caso de uso REAL da Central de Prompts (copiloto | pocket_summary |
/// people_analytics | preliminary_report | document_texts | dossie_action_plan)
/// × documentos autorizados + toggle "uso contextual ativo". Uma linha por
/// (empresa, caso); sem linha = desligado.
model TenantAiUseCaseContext {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  org         Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  useCase     String       @map("use_case")
  documentIds String[]     @default([]) @map("document_ids") @db.Uuid
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([tenantId, useCase])
  @@index([tenantId])
  @@map("tenant_ai_use_case_contexts")
}
