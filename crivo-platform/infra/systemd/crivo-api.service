[Unit]
Description=CRIVO API (NestJS)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/crivo/app
EnvironmentFile=/opt/crivo/api.env
ExecStart=/usr/bin/node apps/api/dist/main.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/crivo-api.log
StandardError=append:/var/log/crivo-api.log

[Install]
WantedBy=multi-user.target
