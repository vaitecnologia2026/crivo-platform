[Unit]
Description=CRIVO Web (Next.js portal/superadm)
After=network.target crivo-api.service

[Service]
Type=simple
WorkingDirectory=/opt/crivo/app/apps/web
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/crivo/app/apps/web/node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=3
StandardOutput=append:/var/log/crivo-web.log
StandardError=append:/var/log/crivo-web.log

[Install]
WantedBy=multi-user.target
